        continue
    fi
    timeout "$SCAN_GREP_SECONDS" grep -aqE -e "$LEAK_SK" -e "$LEAK_JWT" -e "$LEAK_RT" "$snapshot"
    candidate=$?
    if [ "$candidate" -eq 1 ]; then
        timeout "$SCAN_GREP_SECONDS" grep -azqE -e "$LEAK_RT" "$snapshot"
        candidate=$?
        if [ "$candidate" -eq 1 ]; then
            json_verdict=$(json_refresh "$file")
