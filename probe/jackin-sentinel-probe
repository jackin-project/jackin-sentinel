    fi
    _jks_facts_doc=$(jq -n --arg project "$PROJECT" --argjson work_tree "$work_tree" --arg branch "$branch" --arg head "$head" \
        --argjson branches "$branches" --argjson clean "$clean" --argjson stash "$stash" \
