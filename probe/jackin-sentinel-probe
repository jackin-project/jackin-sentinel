have() {
    command -v "$1" >/dev/null 2>&1
}

check() {
    detail=$3
    if [ "$2" != PASS ] && [ -z "$detail" ]; then
        detail="no detail"
    fi
    _jks_doc=$(jq -cn --arg name "$1" --arg result "$2" --arg detail "$detail" \
        '{name: $name, result: $result, detail: ($detail | .[0:300])}') || return 0
    if [ -z "$_jks_doc" ]; then
        return 0
    fi
    if [ -n "$RUN_KEY" ]; then
        _jks_chain=$(printf '%s%s\n' "$RUN_KEY$_jks_chain" "$_jks_doc" | sha256sum)
        _jks_chain=${_jks_chain%% *}
        if [ -n "$_jks_chain" ]; then
            printf '%s\n' "$_jks_chain" >"$work/checks.tag"
        fi
    fi
    printf '%s\n' "$_jks_doc" >>"$work/checks"
}

seal_facts() {
    if [ -z "$1" ]; then
        : >"$work/facts"
        : >"$work/facts.tag"
        return 0
    fi
    printf '%s\n' "$1" >"$work/facts"
    if [ -n "$RUN_KEY" ]; then
        _jks_chain=$(printf '%s%s\n' "$RUN_KEY$_jks_chain" "$1" | sha256sum)
        _jks_chain=${_jks_chain%% *}
        printf '%s\n' "$_jks_chain" >"$work/facts.tag"
    fi
}

seal_replay() {
    _jks_h=$RUN_SEED
    while IFS= read -r _jks_line; do
        [ -n "$_jks_line" ] || continue
        _jks_h=$(printf '%s%s\n' "$RUN_KEY$_jks_h" "$_jks_line" | sha256sum)
        _jks_h=${_jks_h%% *}
    done
    if [ -n "$_jks_checks_tag" ]; then
        [ "$_jks_checks_tag" = "$_jks_h" ] || return 1
    elif [ -n "$_jks_checks" ]; then
        return 1
    fi
    if [ -n "$_jks_facts" ]; then
        [ -n "$_jks_facts_tag" ] || return 1
        _jks_h=$(printf '%s%s\n' "$RUN_KEY$_jks_h" "$_jks_facts" | sha256sum)
        _jks_h=${_jks_h%% *}
        [ "$_jks_facts_tag" = "$_jks_h" ] || return 1
    elif [ -n "$_jks_facts_tag" ]; then
        return 1
    fi
}

pass() {
    check "$1" PASS "${2-}"
}

fail() {
    check "$1" FAIL "$2"
}

skip() {
    check "$1" SKIP "$2"
}

finish() {
    for _jks_material in checks checks.tag facts facts.tag; do
        [ -f "$work/$_jks_material" ] || {
            echo "$PROBE: step $1 seal material is missing; refusing to attest" >&2
            exit 70
        }
    done
    _jks_checks=$(cat "$work/checks")
    _jks_checks_tag=$(cat "$work/checks.tag")
    _jks_facts=$(cat "$work/facts")
    _jks_facts_tag=$(cat "$work/facts.tag")
    if [ -n "$RUN_KEY" ] && ! printf '%s\n' "$_jks_checks" | seal_replay >/dev/null; then
        echo "$PROBE: step $1 evidence does not match its seal; refusing to attest" >&2
        exit 70
    fi
    _jks_step=$(printf '%s\n%s\n' "${_jks_facts:-null}" "$_jks_checks" | jq -cs --arg id "$1" '
        . as $stream | ($stream[0] // null) as $facts | $stream[1:] as $checks
        | ($checks
            + (if ($checks | length) == 0
               then [{name: "checks", result: "FAIL", detail: "the step recorded no check"}]
               else [] end)
            + (if $facts == null and all($checks[]; .result != "SKIP")
               then [{name: "facts", result: "FAIL", detail: "the step collected no facts"}]
               else [] end)) as $c
        | (if any($c[]; .result == "FAIL") then "FAIL"
           elif any($c[]; .result == "SKIP") then "SKIP"
           else "PASS" end) as $r
        | {($id): {
            result: $r,
            reason: (if $r == "PASS" then ""
                     else ([$c[] | select(.result == $r) | "\(.name): \(.detail)"] | join("; ") | .[0:600])
                     end),
            checks: $c,
            facts: $facts}}')
    report_steps="$report_steps$_jks_step
"
}

selected() {
    [ -z "$only" ] && return 0
    case ",$only," in
        *",$1,"*) return 0 ;;
    esac
    return 1
}

require_sandbox() {
    if [ "$(uname -s)" = Linux ] && [ "$(id -un)" = sandbox ] && [ -d /sandbox ]; then
        return 0
    fi
    echo "$PROBE: refusing to run outside a sandbox; use --host for a dry run" >&2
    exit 66
}

bounded_read() {
    bounded_source=$1
    bounded_target=$2
    bounded_cap=$3
    bounded_seconds=$4
    rm -f "$bounded_target"
    if ! timeout "$bounded_seconds" sh "$work/bounded-copy.sh" "$bounded_source" "$bounded_target" "$bounded_cap" "$work/bounded.err" >/dev/null 2>&1; then
        rm -f "$bounded_target"
        return 1
    fi
    return 0
}

log_snapshot() {
    log_source=$1
    log_target=$2
    rm -f "$log_target"
    if [ -L "$log_source" ]; then
        return 1
    fi
    if [ ! -e "$log_source" ]; then
        : >"$log_target"
        return 0
    fi
    if [ ! -f "$log_source" ]; then
        return 1
    fi
    bounded_read "$log_source" "$log_target" "$LOG_BYTE_CAP" "$LOG_READ_SECONDS"
}

count_lines() {
    if log_snapshot "$1" "$work/log.lines"; then
        wc -l <"$work/log.lines" | tr -d ' '
        return 0
    fi
    echo 0
    return 1
}

count_matches() {
    if log_snapshot "$2" "$work/log.matches"; then
        n=$(grep -c "$1" "$work/log.matches" 2>/dev/null) || n=0
        echo "${n:-0}"
        return 0
    fi
    echo 0
    return 1
}

