agent_env() {
    [ -n "$3" ] || {
        : >"$2"
        echo absent
        return 0
    }
    state=$(environ_state "$3")
    if [ "$state" = read ]; then
        fifo="$work/proc-env.$1.$3"
        parsed="$work/proc-env.$1.$3.tsv"
        rm -f "$fifo" "$parsed"
        if ! mkfifo "$fifo" 2>/dev/null; then
            : >"$2"
            echo denied
            return 0
        fi
        proc_environ "$3" >"$fifo" 2>/dev/null &
        producer=$!
        filter_status=0
        if ! credential_variables "$1" <"$fifo" >"$parsed" 2>/dev/null; then
            filter_status=1
        fi
        producer_status=0
        wait "$producer" || producer_status=1
        rm -f "$fifo"
        if [ "$filter_status" -eq 0 ] && [ "$producer_status" -eq 0 ] && mv "$parsed" "$2" 2>/dev/null; then
            echo read
            return 0
        fi
        rm -f "$parsed"
        : >"$2"
        echo denied
        return 0
    fi
    : >"$2"
    echo "$state"
}

record_parse() {
    LC_ALL=C awk '
        function bad() { failed = 1; exit 1 }
        NR == 1 { if ($0 != "jackin-env-kinds 2") bad(); next }
        NR == 2 {
            if ($0 !~ /^attempt (0|[1-9][0-9]*)$/) bad()
            split($0, parts, " ")
            if (length(parts[2]) > 18) bad()
            attempt_number = parts[2]
            print "attempt\t" parts[2]
            next
        }
        {
            if ($0 !~ /^(main|agent) [A-Za-z_][A-Za-z0-9_]* (placeholder|empty|other)$/) bad()
            split($0, parts, " ")
            if (parts[1] == "main" && seen_agent) bad()
            if (parts[1] == "main") seen_main = 1
            if (parts[1] == "agent") seen_agent = 1
            key = parts[1] " " parts[2]
            if (key in used) bad()
            used[key] = 1
            print parts[1] "\t" parts[2] "\t" parts[3]
        }
        END { if (!failed && (NR < 2 || !seen_main || (attempt_number > 0 && !seen_agent))) exit 1 }'
}

record_load() {
    : >"$work/record.tsv"
    record_state=absent
    record_attempt=
    if [ -L "$RECORD_FILE" ]; then
        record_state=malformed
        return 0
    fi
    [ -e "$RECORD_FILE" ] || return 0
    if [ ! -f "$RECORD_FILE" ]; then
        record_state=malformed
        return 0
    fi
    if ! head -c $((RECORD_MAX + 1)) "$RECORD_FILE" >"$work/record.raw" 2>/dev/null; then
        record_state=unreadable
        return 0
    fi
    size=$(wc -c <"$work/record.raw" | tr -d ' ')
    nuls=$(tr -cd '\000' <"$work/record.raw" | wc -c | tr -d ' ')
    if [ "$size" -gt "$RECORD_MAX" ] || [ "$nuls" -ne 0 ]; then
        record_state=malformed
        return 0
    fi
    if record_parse <"$work/record.raw" >"$work/record.tsv"; then
        record_state="read"
        record_attempt=$(awk -F'\t' '$1 == "attempt" { print $2 }' "$work/record.tsv")
    else
        : >"$work/record.tsv"
        record_state=malformed
    fi
}

run_state_attempt() {
    case $run_state in
        waiting) echo 0 ;;
        'running '*)
            n=${run_state#running }
            case $n in
                '' | 0* | *[!0-9]*) return 1 ;;
            esac
            [ "${#n}" -le 18 ] || return 1
            echo "$n"
            ;;
        'exited '*)
            rest=${run_state#exited }
            case $rest in
                *' '*)
                    n=${rest%% *}
                    status=${rest#* }
                    ;;
                *) return 1 ;;
            esac
            case $n in
                '' | 0* | *[!0-9]*) return 1 ;;
            esac
            case $status in
                0) ;;
                '' | 0* | *[!0-9]*) return 1 ;;
            esac
            [ "${#n}" -le 18 ] && [ "${#status}" -le 3 ] && [ "$status" -le 255 ] || return 1
            echo "$n"
            ;;
        *) return 1 ;;
    esac
}

record_rows() {
    awk -F'\t' -v env="$1" '$1 == env { print $2 "\t" $3 "\t" env }' "$work/record.tsv"
}

settle() {
    record_rows "$1" | sort -u >"$work/rec.$1.tsv"
    settled=$2
    if [ "$2" = read ]; then
        sort -u "$work/live.$1.tsv" >"$work/eff.$1.tsv"
        read_from="$read_from, the $1 environment (/proc)"
        if [ "$3" -eq 1 ] && ! cmp -s "$work/eff.$1.tsv" "$work/rec.$1.tsv"; then
            disagree="${disagree:+$disagree, }$1"
        fi
    elif [ "$3" -eq 1 ]; then
        cp "$work/rec.$1.tsv" "$work/eff.$1.tsv"
        read_from="$read_from, the $1 environment (record)"
        settled=record
    else
        : >"$work/eff.$1.tsv"
        unread_from="${unread_from:+$unread_from; }the $1 environment ($2, no fresh record)"
    fi
    cat "$work/eff.$1.tsv" >>"$work/variables.tsv"
}

step_J08() (
    : >"$work/variables.tsv"
    main_pid=
    agent_pids=
    agent_children=0
    if collect_processes 2>/dev/null; then
        main_pid=$(jq -r '.main.pid // empty' "$work/processes.json")
        agent_pids=$(jq -r '.agent[].pid' "$work/processes.json")
