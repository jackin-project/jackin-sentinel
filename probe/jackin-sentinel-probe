        elif [ "$version" != "$EXPECTED_VERSION" ]; then
            fail agent_version "got '$version', expected '$EXPECTED_VERSION'"
        else
            pass agent_version "$version"
        fi
    else
        fail agent_binary "$AGENT_BIN is not an executable file"
    fi
    jq -n --arg path "$AGENT_BIN" --argjson present "$present" --argjson executable "$executable" --arg version "$version" \
        "$JQN"'{agent: {path: $path, present: $present, executable: $executable, version: ($version | n)}}' >"$work/facts"
