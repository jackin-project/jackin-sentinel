import re
import sys

try:
    import yaml
except ImportError:
    yaml = None

url_re = re.compile(r'^https?://[^\s"<>]+\Z')
key_re = re.compile(r'^("(?:[^"\\]|\\.)*"|\'[^\']*\'|[^:#\s][^:]*?)\s*:(?:[ \t]+(.*))?$')
ESCAPE_MAP = {"0": "\0", "a": "\a", "b": "\b", "t": "\t", "n": "\n", "v": "\v", "f": "\f", "r": "\r", "e": "\x1b", " ": " ", '"': '"', "/": "/", "\\": "\\", "N": "\u0085", "_": "\u00a0", "L": "\u2028", "P": "\u2029"}


def decode_escapes(text):
    out = []
    i = 0
    while i < len(text):
        ch = text[i]
        i += 1
        if ch != "\\":
            out.append(ch)
            continue
        if i >= len(text):
            raise ValueError("trailing escape")
        esc = text[i]
        i += 1
        if esc in ("x", "u", "U"):
            width = {"x": 2, "u": 4, "U": 8}[esc]
            digits = text[i:i + width]
            if len(digits) != width:
                raise ValueError("bad escape")
            i += width
            out.append(chr(int(digits, 16)))
        elif esc == "\n":
            while i < len(text) and text[i] in " \t":
                i += 1
        elif esc in ESCAPE_MAP:
            out.append(ESCAPE_MAP[esc])
        else:
            raise ValueError("bad escape")
    return "".join(out)


def plain_root_scalars(text):
    root = {}
    lines = text.split("\n")
    i = 0
    while i < len(lines):
        line = lines[i]
        i += 1
        if line.startswith("%") and not root:
            continue
        if line.startswith("---") and line[3:4] in ("", " ", "\t"):
            line = line[3:].lstrip(" \t")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
        elif line.split("#", 1)[0].rstrip() == "...":
            continue
        if not line.strip() or line[0] in " \t" or line[0] == "#":
            continue
        match = key_re.match(line)
        if match is None:
            raise ValueError("unsupported line")
        raw_key = match.group(1)
        key = decode_escapes(raw_key[1:-1]) if raw_key[0] == '"' else (raw_key[1:-1] if raw_key[0] == "'" else raw_key)
        if key in root:
            raise ValueError("duplicate key")
        rest = match.group(2) or ""
        if not rest.strip() or rest.lstrip().startswith("#"):
            root[key] = None
            continue
        rest = re.sub(r"[ \t]+#.*$", "", rest).strip()
        if rest[0] in "|>":
            header = re.match(r"^[|>](?:([+-])([0-9])?|([0-9])([+-])?)?(?:[ \t]+#.*)?$", rest)
            if header is None:
                raise ValueError("bad block header")
            chomp = header.group(1) or header.group(4) or ""
            indent_hint = header.group(2) or header.group(3) or ""
            block = []
            while i < len(lines):
                line = lines[i]
                if line.strip() == "":
                    block.append("")
                    i += 1
                    continue
                if line[0] in " \t":
                    block.append(line)
                    i += 1
                    continue
                break
            trailing = 0
            while block and block[-1] == "":
                block.pop()
                trailing += 1
            indent = int(indent_hint) if indent_hint else None
            if indent is None:
                for line in block:
                    if line.strip():
                        indent = len(line) - len(line.lstrip(" "))
                        break
            if indent is None:
                indent = 0
            content = []
            for line in block:
                if not line.strip():
                    content.append("")
                elif len(line) - len(line.lstrip(" ")) < indent:
                    raise ValueError("bad block indent")
                else:
                    content.append(line[indent:])
            if rest[0] == "|":
                value = "\n".join(content)
            else:
                parts = []
                prev_blank = False
                first = True
                for line in content:
                    if line == "":
                        parts.append("\n")
                        prev_blank = True
                    else:
                        if not first and not prev_blank:
                            parts.append(" ")
                        parts.append(line)
                        prev_blank = False
                    first = False
                value = "".join(parts)
            if chomp == "+":
                value += "\n" + "\n" * trailing
            elif chomp != "-":
                value += "\n"
            root[key] = value
            continue
        if rest[0] in "\"'":
            value = None
            quote = rest[0]
            buf = rest[1:]
            out = []
            j = 0
            while value is None:
                while j < len(buf):
                    ch = buf[j]
                    j += 1
                    if quote == "'":
                        if ch == "'":
                            if buf[j:j + 1] == "'":
                                out.append("'")
                                j += 1
                                continue
                            tail = buf[j:].strip()
                            if tail and not tail.startswith("#"):
                                raise ValueError("trailing content")
                            value = "".join(out)
                            break
                        out.append(ch)
                    else:
                        if ch == "\\" and j < len(buf):
                            out.append(ch)
                            out.append(buf[j])
                            j += 1
                            continue
                        if ch == '"':
                            tail = buf[j:].strip()
                            if tail and not tail.startswith("#"):
                                raise ValueError("trailing content")
                            value = decode_escapes("".join(out))
                            break
                        out.append(ch)
                if value is None:
                    if i >= len(lines):
                        raise ValueError("unterminated scalar")
                    out.append("\n")
                    buf = lines[i]
                    i += 1
                    j = 0
        else:
            value = rest
            while i < len(lines) and lines[i] and lines[i][0] in " \t" and not lines[i].lstrip().startswith("#"):
                value += " " + lines[i].strip()
                i += 1
        root[key] = value
    return root


try:
    with open(sys.argv[1], encoding="utf-8-sig") as handle:
        if yaml is not None:

            class Loader(yaml.SafeLoader):
                pass

            def construct_mapping(loader, node, deep=False):
                mapping = {}
                for key_node, value_node in node.value:
                    key = loader.construct_object(key_node, deep=deep)
                    if key in mapping:
                        raise ValueError("duplicate key")
                    mapping[key] = loader.construct_object(value_node, deep=deep)
                return mapping

            Loader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, construct_mapping)
            doc = yaml.load(handle, Loader=Loader)
        else:
            doc = plain_root_scalars(handle.read())
except Exception:
    raise SystemExit(1)
if not isinstance(doc, dict) or "baseUrl" not in doc:
    raise SystemExit(1)
value = doc["baseUrl"]
if not isinstance(value, str) or url_re.match(value) is None:
    raise SystemExit(1)
sys.stdout.write(value)
PY
                then
                    return 1
                fi
                declared_parsed=$(cat "$spec_dir/config.declared")
                [ -n "$declared_parsed" ] || return 1
                ;;
            t14-claude-zai-v1)
                declared_parsed=$(jq -er '.env.ANTHROPIC_BASE_URL | select(type == "string" and length > 0)' "$spec_dir/config.normalized" 2>/dev/null) || return 1
