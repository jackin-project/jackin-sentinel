    fi
    case $host in
        tcp://host.openshell.internal:*)
            if [ "$tls" = 1 ] && [ "$cert_path" = "$cert_dir" ]; then
                pass environment "DOCKER_HOST=$host"
            else
                fail environment "DOCKER_TLS_VERIFY or DOCKER_CERT_PATH is wrong"
            fi
            ;;
        *) fail environment "DOCKER_HOST is '${host:-unset}', expected tcp://host.openshell.internal:<port>" ;;
    esac
    if [ -z "$cert_problem" ]; then
        pass certificates "ca.pem, cert.pem and key.pem (mode 600) exist in $cert_dir"
    else
        fail certificates "problem:$cert_problem"
    fi
    if [ "$_jks_docker_run_complete_fact" != true ]; then
        fail hello_world "docker run --rm $HELLO_IMAGE output capture incomplete"
    elif [ "$hello" = true ] && [ "$run_exit" = 0 ]; then
        pass hello_world "docker run --rm $HELLO_IMAGE printed the hello text"
    elif [ "$hello" = true ]; then
        fail hello_world "docker run --rm $HELLO_IMAGE exit ${run_exit:-none}"
    else
        fail hello_world "docker run --rm $HELLO_IMAGE did not print the hello text (exit ${run_exit:-none})"
    fi
    if [ -n "$engine_id" ]; then
        pass engine "$engine_id"
    else
        fail engine "docker info gave no engine id"
    fi
    unset _jks_docker_run_complete_fact
    jq -n --argjson found "$found" --arg path "$docker_path" --arg host "$host" --arg tls "$tls" --arg cert_path "$cert_path" \
        --slurpfile certs "$work/certs.ndjson" --arg run_exit "$run_exit" --argjson hello "$hello" \
        --arg engine_id "$engine_id" --arg engine_version "$engine_version" \
        "$JQN"'{docker_binary: {found: $found, path: ($path | n)},
          environment: {docker_host: ($host | n), tls_verify: ($tls | n), cert_path: ($cert_path | n)},
          certificates: $certs,
          run: {exit_code: ($run_exit | n | if . == null then null else tonumber end), hello: $hello},
          engine: {id: ($engine_id | n), server_version: ($engine_version | n)}}' >"$work/facts"
)

step_J16() (
    if [ "$docker" != off ]; then
        skip docker_capability "the Docker capability is on (--docker off selects this step)"
        return 0
    fi
    binary=false
    have docker && binary=true
    variables=$(env | sed -n 's/^\(DOCKER_[A-Za-z0-9_]*\)=.*/\1/p' | jq -Rn '[inputs]')
    proxies=$(proxy_variables | tr '\n' ' ' | sed 's/ $//')
    attempted=false
    curl_found=false
    have curl && curl_found=true
    reply=null
    control=null
    if [ -n "$engine" ]; then
        attempted=true
        reply=$(egress "https://$engine/_ping")
        control=$(egress https://example.com)
    fi
    if [ "$binary" = false ]; then
        pass docker_binary "no docker binary"
    else
        fail docker_binary "a docker binary exists"
    fi
    if [ "$variables" = '[]' ]; then
        pass docker_variables "no DOCKER_ variable"
    else
        fail docker_variables "set: $(printf '%s' "$variables" | jq -r 'join(" ")')"
    fi
    if [ -n "$proxies" ]; then
        fail engine_denied "proxy variables are set: $proxies"
    elif [ "$attempted" = false ]; then
        skip engine_denied "no --engine endpoint was given"
    else
        case $(egress_outcome "$reply") in
            unresolved)
                if [ "$(egress_outcome "$control")" = refused ]; then
                    pass engine_denied "$engine does not resolve (curl exit 6) while example.com resolves and is refused: the policy refuses the name"
                else
                    fail engine_denied "$engine did not resolve (curl exit 6) and the control name example.com gave $(egress_outcome "$control"): a resolver fault cannot be told from a policy denial"
                fi
                ;;
            *) denial_check engine_denied "$engine" "$reply" ;;
        esac
    fi
    jq -n --argjson binary "$binary" --argjson variables "$variables" --arg engine "$engine" \
        --argjson attempted "$attempted" --argjson curl_found "$curl_found" --argjson reply "$reply" --argjson control "$control" \
        "$JQN"'{docker_binary: $binary, docker_variables: $variables, endpoint: ($engine | n),
          connection: {attempted: $attempted, curl_found: $curl_found, curl_exit: ($reply.curl_exit // null), http_code: ($reply.http_code // 0)},
          resolver_control: $control}' >"$work/facts"
)

main() {
    mode=sandbox
    docker=off
    engine=
    only=
    spec=
    while [ $# -gt 0 ]; do
        case $1 in
            --version)
                echo "$PROBE $VERSION"
                exit 0
                ;;
            --host) mode=host ;;
            --docker)
                [ $# -ge 2 ] || usage
                case $2 in
                    on | off) docker=$2 ;;
                    *) usage ;;
                esac
                shift
                ;;
            --engine)
                [ $# -ge 2 ] || usage
                case $2 in
                    '' | *[!A-Za-z0-9.:-]* | *:*:* | :* | *:) usage ;;
                    *:*[!0-9]*) usage ;;
                    *:*) engine=$2 ;;
                    *) usage ;;
                esac
                shift
                ;;
            --spec)
                [ $# -ge 2 ] || usage
                spec=$2
                shift
                ;;
            --only)
                [ $# -ge 2 ] || usage
                only=$2
                shift
                ;;
            *) usage ;;
        esac
        shift
    done
    if [ "$mode" = sandbox ]; then
        PATH=$SANDBOX_PATH
        export PATH
    fi
    if [ -n "$only" ]; then
        case $only in
            *[!A-Za-z0-9,]*) usage ;;
        esac
        [ -n "$(printf '%s' "$only" | tr -d ',')" ] || usage
        for id in $(printf '%s' "$only" | tr ',' ' '); do
            case " $ALL_STEPS " in
                *" $id "*) ;;
                *) usage ;;
            esac
        done
    fi
    have jq || {
        echo "$PROBE: jq is required" >&2
        exit 69
    }
    if [ -z "$spec" ] || [ ! -f "$spec" ] || [ -L "$spec" ]; then
        echo "$PROBE: --spec must name a regular private probe specification" >&2
        exit 65
    fi
    if ! jq -e '
        (.target | type == "object" and (.model | type == "string" and length > 0) and
            (.provider | type == "string" and length > 0) and
            (.adapter | type == "string" and length > 0) and
            (.spec_sha256 | test("^[0-9a-f]{64}$")) and
            ((.tuple == "T01" and .agent == "codex" and .provider == "codex" and .adapter == "t01-codex-v1") or
             (.tuple == "T09" and .agent == "omp" and .provider == "zai" and .adapter == "t09-omp-zai-v1") or
             (.tuple == "T14" and .agent == "claude" and .provider == "zai" and .adapter == "t14-claude-zai-v1") or
             (.tuple == "T18" and .agent == "codex" and .provider == "zai" and .adapter == "t18-codex-zai-v1"))) and
        (.behavior.version.binary | type == "string" and length > 0) and
        (.behavior.version.exact_output | type == "string" and length > 0) and
        (.behavior.process.comm | type == "string" and length > 0) and
        (.behavior.prompt.argv | type == "array" and length > 0 and all(.[]; type == "string")) and
        (.behavior.prompt.answer.word_case_insensitive.word == "ready") and
        (.behavior.prompt.tool.argv | type == "array" and length > 0 and all(.[]; type == "string")) and
        (.behavior.prompt.tool.answer.word_case_insensitive.word == "ready") and
        (.behavior.prompt.tool.kind | type == "string" and length > 0) and
        (.behavior.prompt.tool.workdir | type == "string" and length > 0) and
        (.behavior.prompt.tool.observation.directory_contains.entries | type == "array" and length > 0 and all(.[]; type == "string" and length > 0)) and
        (.behavior.credential.classification | type == "string" and (IN("oauth_login", "static_key", "api_key"))) and
        (.behavior.credential.environment | type == "array" and length > 0 and (.[0].name | test("^[A-Za-z_][A-Za-z0-9_]*$"))) and
        ((.behavior.credential.classification == "static_key" and (.credential_sha256 | test("^[0-9a-f]{64}$"))) or
         (.behavior.credential.classification != "static_key")) and
        (.behavior.credential.auth_file.path | type == "string" and length > 0) and
        (.behavior.credential.auth_file.required_state | IN("present", "absent")) and
        (.behavior.credential.auth_file.fields | type == "array") and
        ((.behavior.provider.accepted_status == null and .behavior.provider.accepted_body == null) or
         (.behavior.provider.accepted_status | type == "number") and .behavior.provider.accepted_body.json_error_code.code == "invalid_api_key")
    ' "$spec" >/dev/null 2>&1; then
        echo "$PROBE: the private probe specification is malformed or unsupported" >&2
        exit 65
    fi
    AGENT_BIN=$(jq -r '.behavior.version.binary' "$spec") || exit 65
    EXPECTED_VERSION=$(jq -r '.behavior.version.exact_output' "$spec") || exit 65
    AGENT_COMM=$(jq -r '.behavior.process.comm' "$spec") || exit 65
    AUTH_FILE=$(jq -r '.behavior.credential.auth_file.path' "$spec") || exit 65
    AUTH_REQUIRED=$(jq -r '.behavior.credential.auth_file.required_state' "$spec") || exit 65
    PROVIDER_URL=$(jq -r '.behavior.provider.probe_url' "$spec") || exit 65
    PROVIDER_STATUS=$(jq -r '.behavior.provider.accepted_status // 0' "$spec") || exit 65
    PROMPT_ARGV=$(jq -r '.behavior.prompt.argv[] | @base64' "$spec") || exit 65
    TOOL_ARGV=$(jq -r '.behavior.prompt.tool.argv[] | @base64' "$spec") || exit 65
    TOOL_KIND=$(jq -r '.behavior.prompt.tool.kind' "$spec") || exit 65
    TOOL_WORKDIR=$(jq -r '.behavior.prompt.tool.workdir' "$spec") || exit 65
    TOOL_OBSERVATION=$(jq -r '.behavior.prompt.tool.observation.directory_contains.entries[] | @base64' "$spec") || exit 65
    CREDENTIAL_CLASS=$(jq -r '.behavior.credential.classification' "$spec") || exit 65
    CREDENTIAL_ENV=$(jq -r '.behavior.credential.environment[0].name' "$spec") || exit 65
    CREDENTIAL_FINGERPRINT=$(jq -r '.credential_sha256 // ""' "$spec") || exit 65
    EXPECTED_PROVIDER=$(jq -r '.target.provider' "$spec") || exit 65
    EXPECTED_MODEL=$(jq -r '.target.model' "$spec") || exit 65
    ADAPTER=$(jq -r '.target.adapter' "$spec") || exit 65
    if [ "$CREDENTIAL_CLASS" = static_key ] && [ -n "$CREDENTIAL_FINGERPRINT" ]; then
        eval "selected_value=\${$CREDENTIAL_ENV-}"
        if [ -n "$selected_value" ] && [ "$(printf '%s' "$selected_value" | sha256sum | cut -d' ' -f1)" = "$CREDENTIAL_FINGERPRINT" ]; then
            RAW_CREDENTIAL=1
        fi
    fi
    [ "$mode" = host ] || require_sandbox
    work=$(mktemp -d) || exit 70
    trap 'rm -rf "$work"' EXIT
    trap 'exit 70' INT TERM HUP
    for id in $ALL_STEPS; do
        selected "$id" || continue
        : >"$work/checks"
        : >"$work/facts"
        if [ "$mode" = host ]; then
            skip sandbox "not running in a sandbox (--host)"
        else
            "step_$id" || true
        fi
        finish "$id"
    done
    cat "$work"/step.J* | jq -cMs --arg mode "$mode" --arg docker "$docker" --arg engine "$engine" \
        --slurpfile spec "$spec" \
        "$JQN"'{schema: 3, probe: "jackin-sentinel-probe", target: $spec[0].target,
          mode: $mode, docker: $docker, engine: ($engine | n), steps: add}'
}

main "$@"
