    agent_fail_count=0
    : >"$work/live.agent.tsv"
    for pid in $agent_pids; do
        child_env=$(agent_env agent "$work/live.agent.$pid.tsv" "$pid")
        if [ "$child_env" = read ]; then
            agent_read_count=$((agent_read_count + 1))
            cat "$work/live.agent.$pid.tsv" >>"$work/live.agent.tsv"
        else
            agent_read_failed=1
            agent_fail_count=$((agent_fail_count + 1))
        fi
    done
    if [ "$agent_read_count" -gt 0 ]; then
        agent_env='read'
    elif [ "$agent_read_failed" -eq 1 ]; then
        agent_env=denied
    fi
    agent_read_label="$agent_read_count child environments"
    agent_fail_label="$agent_fail_count child environments"
    [ "$agent_read_count" -eq 1 ] && agent_read_label='1 child environment'
    [ "$agent_fail_count" -eq 1 ] && agent_fail_label='1 child environment'
    if [ "$agent_fail_count" -gt 0 ] && [ "$agent_known" -ne 1 ]; then
        unread_from="${unread_from:+$unread_from; }$agent_fail_count Codex child environment(s) could not be read"
    fi
    disagree=
    settle main "$main_env" "$main_known"
    main_env=$settled
    settle agent "$agent_env" "$agent_known"
    agent_env=$settled
    if [ "$agent_read_count" -gt 0 ] && [ "$agent_fail_count" -gt 0 ] && [ "$agent_known" -eq 1 ]; then
        cat "$work/rec.agent.tsv" >>"$work/variables.tsv"
        read_from="$read_from, the fresh aggregate Codex record"
    fi
    sort -u -o "$work/variables.tsv" "$work/variables.tsv"
    environment=$(jq -Rn '[inputs | split("\t") | {name: .[0], kind: .[1], source: .[2]}]' <"$work/variables.tsv")
    environment=$(printf '%s' "$environment" | jq -c --arg name "$CREDENTIAL_ENV" --arg class "$CREDENTIAL_CLASS" --argjson raw "$RAW_CREDENTIAL" '
        map(if $class == "static_key" and .name == $name and .kind == "other" and $raw == 0 then .kind = "brokered" else . end)')
    others=$(printf '%s' "$environment" | jq -r '[.[] | select(.kind == "other") | .name] | unique | join(" ")')
    placeholders=$(printf '%s' "$environment" | jq -r '[.[] | select(.kind == "placeholder" or .kind == "brokered")] | length')
    scope="checked: $read_from, $AUTH_FILE, the files under $SCAN_ROOT; unreadable: ${unread_from:-nothing}"
    auth_file=$(jq -n --arg path "$AUTH_FILE" '{state: "absent", path: $path, mode: null, fields: []}')
    auth_problem=
    auth_placeholders=0
    auth="$AUTH_FILE"
    if [ -f "$auth" ]; then
        auth_state=present
        meta=$(file_meta "$auth") || meta="65534 000"
        read -r _ mode <<EOF
$meta
EOF
        if ! jq -e . "$auth" >/dev/null 2>&1; then
            fields='[]'
            auth_state=malformed
            auth_problem=1
        else
            fields=$(jq -cn --slurpfile parsed "$auth" --slurpfile selected "$spec" --arg re "$PLACEHOLDER_RE" --arg id_token "$PLACEHOLDER_ID_TOKEN" '
            def pointer($name): $name | split("/") | map(select(length > 0));
            def kind($value; $jwt):
                if $value == null then "absent"
                elif $value == "" then "empty"
                elif $jwt and $value == $id_token then "placeholder"
                elif ($value | type == "string" and (test($re + "\\z") or . == "placeholder")) then "placeholder"
                else "other" end;
            [$selected[0].behavior.credential.auth_file.fields[] as $field |
                ($parsed[0] | getpath(pointer($field.name))) as $value |
                if ($field.kind | type) == "object" and $field.kind.literal.value != null then
                    {name: $field.name, kind: (if $value == $field.kind.literal.value then "literal:" + $value else "other" end)}
                else
                    {name: $field.name, kind: kind($value; $field.name == "/tokens/id_token")}
                end]') || fields='[]'
        fi
        auth_file=$(jq -n --arg state "$auth_state" --arg path "$auth" --arg mode "$mode" --argjson fields "$fields" \
            '{state: $state, path: $path, mode: $mode, fields: $fields}')
        if [ "$ADAPTER" = t01-codex-v1 ]; then
            kinds=$(token_kinds "$auth") || kinds="other other other"
            case $kinds in
                *other*)
                    auth_problem=1
                    fields=$(printf '%s' "$fields" | jq -c 'map(if .name == "/tokens/access_token" then .kind = "other" else . end)')
                    auth_file=$(jq -n --arg state "$auth_state" --arg path "$auth" --arg mode "$mode" --argjson fields "$fields" \
                        '{state: $state, path: $path, mode: $mode, fields: $fields}')
                    ;;
            esac
        fi
        if [ "$(printf '%s' "$fields" | jq -r 'any(.[]; .kind == "other")')" = true ]; then
            auth_problem=1
        fi
        auth_placeholders=$(printf '%s' "$fields" | jq -r '[.[] | select(.kind == "placeholder")] | length')
    elif [ -e "$auth" ] || [ -L "$auth" ]; then
        auth_file=$(jq -n --arg path "$auth" '{state: "malformed", path: $path, mode: null, fields: []}')
        auth_problem=1
    elif [ "$AUTH_REQUIRED" = present ]; then
        auth_problem=1
    fi
    if [ "$placeholders" -eq 0 ] && [ "$auth_placeholders" -eq 0 ]; then
        skip credential "the sandbox holds no credential placeholder ($scope)"
    else
        pass credential "$placeholders placeholder variables, $auth_placeholders placeholder tokens in auth.json ($scope)"
    fi
    if [ "$record_state" = malformed ]; then
        fail environment "malformed start record"
    elif [ -n "$others" ]; then
        detail="not a placeholder: $others"
        if [ "$agent_children" -gt 1 ]; then
            detail="$detail; $agent_children Codex processes, read $agent_read_label"
            if [ "$agent_fail_count" -gt 0 ]; then
                if [ "$agent_known" -eq 1 ]; then
                    detail="$detail; $agent_fail_label unread; the fresh aggregate Codex record is retained"
                else
                    detail="$detail; $agent_fail_label unread"
                fi
            fi
        fi
        fail environment "$detail${disagree:+ (/proc and the start record disagree for: $disagree)}"
    elif [ "$agent_children" -gt 1 ]; then
        detail="$agent_children Codex processes are children of the main process; read $agent_read_label"
        if [ "$agent_fail_count" -gt 0 ]; then
            detail="$detail; $agent_fail_label could not be read"
            if [ "$agent_known" -eq 1 ]; then
                detail="$detail; the fresh aggregate Codex record is retained"
            fi
        fi
        fail environment "$detail"
    elif [ "$record_state" != read ]; then
        case $record_state in
            absent) skip environment "no start record at $RECORD_FILE; the environments are unknown, never clean" ;;
            unreadable) skip environment "the start record at $RECORD_FILE cannot be read" ;;
            *) skip environment "the start record is stale (record attempt $record_attempt, run state '${run_state:-absent}')" ;;
        esac
    elif [ "$agent_known" -ne 1 ]; then
        skip environment "the Codex environment is not known: the record at attempt $record_attempt holds no Codex environment"
    else
        pass environment "every credential variable is a placeholder or empty, via record: $read_from${disagree:+; /proc wins where it disagrees: $disagree}"
    fi
    if [ -f "$auth" ]; then
        if [ "$AUTH_REQUIRED" = absent ]; then
            fail auth_file "the selected target requires an absent auth file"
        elif [ -z "$auth_problem" ]; then
            pass auth_file "auth.json holds only placeholders and empty values"
        else
            fail auth_file "auth.json holds a token that is not a placeholder"
        fi
    elif [ -e "$auth" ] || [ -L "$auth" ]; then
        fail auth_file "$auth exists but is not a regular file, so the probe did not examine its tokens"
    elif [ "$AUTH_REQUIRED" = present ]; then
        fail auth_file "the selected target requires auth.json at $auth"
    else
        pass auth_file "the selected target auth file is absent"
    fi
    if [ "$leaks" != '[]' ]; then
        fail file_scan "token-shaped strings in $(printf '%s' "$leaks" | jq -r 'join(" ")')"
    elif [ "$unscanned" -gt 0 ]; then
        skip file_scan "$unscanned_text"
    else
        pass file_scan "no token-shaped string outside the project"
    fi
    case $record_state in
        read | stale) attempt_fact=$record_attempt ;;
        *) attempt_fact=null ;;
    esac
    jq -n --argjson environment "$environment" --argjson auth_file "$auth_file" --argjson leaks "$leaks" \
        --arg main_env "$main_env" --arg agent_env "$agent_env" \
        --arg record_state "$record_state" --argjson record_attempt "$attempt_fact" \
        '{environment: $environment, agent_environment: {main: $main_env, agent: $agent_env},
          start_record: {state: $record_state, attempt: $record_attempt},
          auth_file: $auth_file, leaks: $leaks}' >"$work/facts"
)

step_J09() (
