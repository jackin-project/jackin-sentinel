    fi
    read_from="the probe environment, $launch_files launch env file(s)"
    unread_from=
    if [ -n "$launch_problem" ]; then
        unread_from="${unread_from:+$unread_from; }the launch environment could not be read: $launch_problem"
    fi
    scan_leaks
    leaks=$(printf '%s' "$scan_result" | jq -c '.leaks')
    leak_count=$(printf '%s' "$scan_result" | jq -r '.leak_count')
    unscanned=$(printf '%s' "$scan_result" | jq -r '.unscanned | length')
    exhausted=$(printf '%s' "$scan_result" | jq -r '.exhausted')
    exhausted_text=$(printf '%s' "$scan_result" | jq -r '.exhausted_reasons | join(", ")')
    if [ "$unscanned" -gt 0 ]; then
        unscanned_text="$unscanned paths under $SCAN_ROOT not scanned ($(printf '%s' "$scan_result" | jq -r '.reasons')): $(printf '%s' "$scan_result" | jq -r '.unscanned[0:3] | join(", ")')"
        unread_from="${unread_from:+$unread_from; }$unscanned_text"
    fi
    record_load
    state_attempt=$(run_state_attempt) || state_attempt=
    if [ "$record_state" = read ] && [ "$record_attempt" != "$state_attempt" ]; then
        record_state=stale
    fi
    main_known=0
    agent_known=0
    if [ "$record_state" = read ]; then
        main_known=1
        agent_lines=$(awk -F'\t' '$1 == "agent"' "$work/record.tsv" | wc -l | tr -d ' ')
        if [ "$record_attempt" -ge 1 ]; then
            case $run_state in
                'exited '*' 65') [ "$agent_lines" -eq 0 ] || agent_known=1 ;;
                *) agent_known=1 ;;
            esac
        fi
    fi
    main_env=$(agent_env main "$work/live.main.tsv" "$main_pid")
    agent_env=absent
    agent_read_failed=0
    agent_read_count=0
    agent_fail_count=0
    : >"$work/live.agent.tsv"
    for pid in $agent_pids; do
        child_env=$(agent_env agent "$work/live.agent.$pid.tsv" "$pid")
        if [ "$child_env" = read ]; then
            agent_read_count=$((agent_read_count + 1))
            cat "$work/live.agent.$pid.tsv" >>"$work/live.agent.tsv"
        else
            agent_read_failed=1
            agent_fail_count=$((agent_fail_count + 1))
        fi
    done
    if [ "$agent_read_count" -gt 0 ]; then
        agent_env='read'
    elif [ "$agent_read_failed" -eq 1 ]; then
        agent_env=denied
    fi
    agent_read_label="$agent_read_count child environments"
    agent_fail_label="$agent_fail_count child environments"
    [ "$agent_read_count" -eq 1 ] && agent_read_label='1 child environment'
    [ "$agent_fail_count" -eq 1 ] && agent_fail_label='1 child environment'
    if [ "$agent_fail_count" -gt 0 ] && [ "$agent_known" -ne 1 ]; then
        unread_from="${unread_from:+$unread_from; }$agent_fail_count Codex child environment(s) could not be read"
    fi
    disagree=
    settle main "$main_env" "$main_known"
    main_env=$settled
    settle agent "$agent_env" "$agent_known"
    agent_env=$settled
    if [ "$agent_read_count" -gt 0 ] && [ "$agent_fail_count" -gt 0 ] && [ "$agent_known" -eq 1 ]; then
        cat "$work/rec.agent.tsv" >>"$work/variables.tsv"
        read_from="$read_from, the fresh aggregate Codex record"
    fi
    sort -u -o "$work/variables.tsv" "$work/variables.tsv"
    environment=$(jq -Rn '[inputs | split("\t") | {name: .[0], kind: .[1], source: .[2]}]' <"$work/variables.tsv")
    environment=$(printf '%s' "$environment" | jq -c --arg name "$CREDENTIAL_ENV" --arg class "$CREDENTIAL_CLASS" --argjson raw "$RAW_CREDENTIAL" '
        map(if $class == "static_key" and .name == $name and .kind == "other" and $raw == 0 then .kind = "brokered" else . end)')
    others=$(printf '%s' "$environment" | jq -r '[.[] | select(.kind == "other") | .name] | unique | join(" ")')
    placeholders=$(printf '%s' "$environment" | jq -r '[.[] | select(.kind == "placeholder" or .kind == "brokered")] | length')
    scope="checked: $read_from, $AUTH_FILE, the files under $SCAN_ROOT; unreadable: ${unread_from:-nothing}"
    auth_file=$(jq -n --arg path "$AUTH_FILE" '{state: "absent", path: $path, mode: null, fields: []}')
    auth_problem=
    auth_placeholders=0
    auth="$AUTH_FILE"
    if [ -f "$auth" ]; then
        auth_state=present
        meta=$(file_meta "$auth") || meta="65534 000"
        read -r _ mode <<EOF
$meta
EOF
        if ! jq -e . "$auth" >/dev/null 2>&1; then
            fields='[]'
            auth_state=malformed
            auth_problem=1
        else
            fields=$(auth_file_fields "$auth") || {
                fields='[]'
                auth_problem=1
            }
        fi
        auth_file=$(jq -n --arg state "$auth_state" --arg path "$auth" --arg mode "$mode" --argjson fields "$fields" \
            '{state: $state, path: $path, mode: $mode, fields: $fields}')
        if [ "$ADAPTER" = t01-codex-v1 ]; then
            kinds=$(token_kinds "$auth") || kinds="other other other"
            case $kinds in
                *other*)
                    auth_problem=1
                    fields=$(printf '%s' "$fields" | jq -c 'map(if .name == "/tokens/access_token" then .kind = "other" else . end)')
                    auth_file=$(jq -n --arg state "$auth_state" --arg path "$auth" --arg mode "$mode" --argjson fields "$fields" \
                        '{state: $state, path: $path, mode: $mode, fields: $fields}')
                    ;;
            esac
        fi
        if [ "$(printf '%s' "$fields" | jq -r 'any(.[]; .kind == "other")')" = true ]; then
            auth_problem=1
        fi
        auth_placeholders=$(printf '%s' "$fields" | jq -r '[.[] | select(.kind == "placeholder")] | length')
    elif [ -e "$auth" ] || [ -L "$auth" ]; then
        auth_file=$(jq -n --arg path "$auth" '{state: "malformed", path: $path, mode: null, fields: []}')
        auth_problem=1
    elif [ "$AUTH_REQUIRED" = present ]; then
        auth_problem=1
    fi
    if [ -n "$launch_problem" ]; then
        fail launch_env "$launch_problem"
    else
        pass launch_env "$launch_files launch environment file(s) read within $LOG_BYTE_CAP bytes"
    fi
    if [ "$placeholders" -eq 0 ] && [ "$auth_placeholders" -eq 0 ]; then
        skip credential "the sandbox holds no credential placeholder ($scope)"
    else
        pass credential "$placeholders placeholder variables, $auth_placeholders placeholder tokens in auth.json ($scope)"
    fi
    if [ "$record_state" = malformed ]; then
        fail environment "malformed start record"
    elif [ -n "$others" ]; then
        detail="not a placeholder: $others"
        if [ "$agent_children" -gt 1 ]; then
            detail="$detail; $agent_children Codex processes, read $agent_read_label"
            if [ "$agent_fail_count" -gt 0 ]; then
                if [ "$agent_known" -eq 1 ]; then
                    detail="$detail; $agent_fail_label unread; the fresh aggregate Codex record is retained"
                else
                    detail="$detail; $agent_fail_label unread"
                fi
            fi
        fi
        fail environment "$detail${disagree:+ (/proc and the start record disagree for: $disagree)}"
    elif [ "$agent_children" -gt 1 ]; then
        detail="$agent_children Codex processes are children of the main process; read $agent_read_label"
        if [ "$agent_fail_count" -gt 0 ]; then
            detail="$detail; $agent_fail_label could not be read"
            if [ "$agent_known" -eq 1 ]; then
                detail="$detail; the fresh aggregate Codex record is retained"
            fi
        fi
        fail environment "$detail"
    elif [ "$main_count" -gt 1 ]; then
        fail environment "$main_count top-level processes verify as $START_BIN (pids $main_pids); only pid $main_pid was inspected"
    elif [ "$record_state" != read ]; then
        case $record_state in
            absent) skip environment "no start record at $RECORD_FILE; the environments are unknown, never clean" ;;
            unreadable) skip environment "the start record at $RECORD_FILE cannot be read" ;;
            *) skip environment "the start record is stale (record attempt $record_attempt, run state '${run_state:-absent}')" ;;
        esac
    elif [ "$agent_known" -ne 1 ]; then
        skip environment "the Codex environment is not known: the record at attempt $record_attempt holds no Codex environment"
    elif [ -n "$launch_problem" ]; then
        fail environment "the launch environment could not be read, so the credentials are unknown: $launch_problem"
    elif [ -n "$disagree" ]; then
        fail environment "every credential variable is a placeholder or empty, but the start record and /proc disagree for: $disagree"
    else
        pass environment "every credential variable is a placeholder or empty, via record: $read_from"
    fi
    if [ -f "$auth" ]; then
        if [ "$AUTH_REQUIRED" = absent ]; then
            fail auth_file "the selected target requires an absent auth file"
        elif [ -z "$auth_problem" ]; then
            pass auth_file "auth.json holds only placeholders and empty values"
        else
            fail auth_file "auth.json holds a token that is not a placeholder"
        fi
    elif [ -e "$auth" ] || [ -L "$auth" ]; then
        fail auth_file "$auth exists but is not a regular file, so the probe did not examine its tokens"
    elif [ "$AUTH_REQUIRED" = present ]; then
        fail auth_file "the selected target requires auth.json at $auth"
    else
        pass auth_file "the selected target auth file is absent"
    fi
    if [ "$exhausted" = true ]; then
        fail file_scan "the scan did not finish: $exhausted_text"
    elif [ "$leaks" != '[]' ]; then
        fail file_scan "token-shaped strings in $(printf '%s' "$leaks" | jq -r 'join(" ")')"
    elif [ "$unscanned" -gt 0 ]; then
        skip file_scan "$unscanned_text"
    else
        pass file_scan "no token-shaped string outside the project"
    fi
    case $record_state in
        read | stale) attempt_fact=$record_attempt ;;
        *) attempt_fact=null ;;
    esac
    _jks_facts_doc=$(jq -n --argjson environment "$environment" --argjson auth_file "$auth_file" --argjson leaks "$leaks" \
        --argjson leak_count "$leak_count" \
        --arg main_env "$main_env" --arg agent_env "$agent_env" \
        --arg record_state "$record_state" --argjson record_attempt "$attempt_fact" \
        '{environment: $environment, agent_environment: {main: $main_env, agent: $agent_env},
          start_record: {state: $record_state, attempt: $record_attempt},
          auth_file: $auth_file, leaks: $leaks, leak_count: $leak_count}')
    seal_facts "$_jks_facts_doc"
)

step_J09() (
    ensure_agent_exec
    outside=$(egress https://example.com)
    metadata=$(egress http://169.254.169.254/latest/meta-data/)
    proxies=$(proxy_variables | tr '\n' ' ' | sed 's/ $//')
    bearer=
    if [ "${CODEX_AUTH_ACCESS_TOKEN-}" != "" ]; then
        bearer=$CODEX_AUTH_ACCESS_TOKEN
    elif [ "${OPENAI_API_KEY-}" != "" ]; then
        bearer=$OPENAI_API_KEY
    fi
    if [ -z "$bearer" ] && [ -f "$AUTH_FILE" ]; then
        bearer=$(jq -r '[.tokens.access_token, .OPENAI_API_KEY] | map(select(type == "string" and . != "")) | .[0] // empty' "$AUTH_FILE" 2>/dev/null) || bearer=
    fi
    if [ "$CREDENTIAL_CLASS" = static_key ] && [ "$RAW_CREDENTIAL" -eq 0 ]; then
        bearer="openshell:resolve:env:$CREDENTIAL_ENV"
    fi
    provider=null
    if [ -n "$bearer" ] && printf '%s' "$bearer" | is_placeholder; then
        : >"$work/provider.body"
        provider=$(egress "$PROVIDER_URL" "$bearer" "$work/provider.body")
        if provider_saw_only "$bearer" "$work/provider.body"; then
            provider=$(printf '%s' "$provider" | jq -c '.body = "invalid_api_key"')
        else
            provider=$(printf '%s' "$provider" | jq -c '.body = "other"')
        fi
    fi
    if agent_exec_verified; then
        _jks_ae_facts_doc=$_jks_agent_exec_doc
        attempted=$(
            jq -r '.attempted' /dev/fd/4 4<<EOF_JKS_AGENT_EXEC
$_jks_agent_exec_doc
EOF_JKS_AGENT_EXEC
        )
        ae_answered=$(
            jq -r '.answered' /dev/fd/4 4<<EOF_JKS_AGENT_EXEC
$_jks_agent_exec_doc
EOF_JKS_AGENT_EXEC
        )
        ae_exit=$(
            jq -r '.exit_code' /dev/fd/4 4<<EOF_JKS_AGENT_EXEC
$_jks_agent_exec_doc
EOF_JKS_AGENT_EXEC
        )
        complete=$(
            printf '%s\n' "$TOOL_OBSERVATION_EXPECTED" | jq -r --arg provider "$EXPECTED_PROVIDER" --rawfile model /dev/fd/3 --arg kind "$TOOL_KIND" --arg workdir "$TOOL_WORKDIR" \
                --arg endpoint "$PROVIDER_URL" --slurpfile expected /dev/stdin '
        .answered == true and .actual_provider == $provider and .actual_model == ($model | rtrimstr("\n")) and
        (.actual_endpoint == $endpoint and (.sandbox_endpoint | IN("", $endpoint))) and
        .tool.kind == $kind and .tool.attempted == true and .tool.succeeded == true and
        .tool.exit_code == 0 and .tool.workdir == $workdir and
        ([.tool.observation[]] as $obs | $expected[0] | all(. as $entry | $obs | index($entry) != null))' /dev/fd/4 3<<EOF_JKS_EXPECTED_MODEL 4<<EOF_JKS_AGENT_EXEC
$EXPECTED_MODEL
EOF_JKS_EXPECTED_MODEL
$_jks_agent_exec_doc
EOF_JKS_AGENT_EXEC
        )
        endpoint_mismatch=$(
            jq -r --arg endpoint "$PROVIDER_URL" \
                '.actual_endpoint != $endpoint or .sandbox_endpoint == null or
         (.sandbox_endpoint != "" and .sandbox_endpoint != $endpoint)' /dev/fd/4 4<<EOF_JKS_AGENT_EXEC
$_jks_agent_exec_doc
EOF_JKS_AGENT_EXEC
        )
        if [ "$attempted" = true ]; then
            if [ "$complete" = true ]; then
                pass agent_reaches_api "codex exec answered and completed the declared tool"
            elif [ "$ae_answered" != true ]; then
                fail agent_reaches_api "codex exec exit $ae_exit gave no answer"
            elif [ "$endpoint_mismatch" = true ]; then
                fail agent_reaches_api "the provider endpoint is not the contract endpoint $PROVIDER_URL"
            else
                fail agent_reaches_api "agent exec or tool evidence is incomplete (exit $ae_exit)"
            fi
        elif [ "${config_gate_refused-}" = 1 ]; then
            fail agent_reaches_api "the provider endpoint is not the contract endpoint $PROVIDER_URL; the launches were refused because the declared configuration was not validated and pinned"
        else
            skip agent_reaches_api "$(cat "$work/agent_exec.why")"
        fi
    else
        _jks_ae_facts_doc=null
        fail agent_reaches_api "the agent exec evidence is not authentic"
    fi
    if [ -n "$proxies" ]; then
        fail outside_host_denied "proxy variables are set: $proxies"
        fail metadata_denied "proxy variables are set: $proxies"
    else
        denial_check outside_host_denied example.com "$outside"
        denial_check metadata_denied 169.254.169.254 "$metadata"
    fi
    if [ "$provider" = null ]; then
        skip provider_no_credential "no placeholder to send"
