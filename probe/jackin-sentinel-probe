        _jks_docker_info_complete=0
        _jks_docker_info_hello=0
        _jks_docker_engine_id=
        _jks_docker_engine_version=
        if [ "$_jks_docker_info_parse_status" -eq 0 ] && IFS=' ' read -r _jks_docker_info_producer _jks_docker_info_complete _jks_docker_info_hello _jks_docker_engine_id _jks_docker_engine_version <<EOF
$_jks_docker_info_parsed
