git_in() {
    # shellcheck disable=SC2016
    /usr/bin/env -i /bin/sh -c '
        case $1 in x*) PATH=${1#x}; export PATH ;; *) unset PATH ;; esac
        case $2 in x*) HOME=${2#x}; export HOME ;; *) unset HOME ;; esac
        case $3 in x*) XDG_CONFIG_HOME=${3#x}; export XDG_CONFIG_HOME ;; *) unset XDG_CONFIG_HOME ;; esac
        case $4 in x*) TMPDIR=${4#x}; export TMPDIR ;; *) unset TMPDIR ;; esac
        case $5 in x*) LANG=${5#x}; export LANG ;; *) unset LANG ;; esac
        case $6 in x*) LANGUAGE=${6#x}; export LANGUAGE ;; *) unset LANGUAGE ;; esac
        case $7 in x*) LC_ALL=${7#x}; export LC_ALL ;; *) unset LC_ALL ;; esac
        case $8 in x*) LC_COLLATE=${8#x}; export LC_COLLATE ;; *) unset LC_COLLATE ;; esac
        case $9 in x*) LC_CTYPE=${9#x}; export LC_CTYPE ;; *) unset LC_CTYPE ;; esac
        case ${10} in x*) LC_MESSAGES=${10#x}; export LC_MESSAGES ;; *) unset LC_MESSAGES ;; esac
        case ${11} in x*) LC_MONETARY=${11#x}; export LC_MONETARY ;; *) unset LC_MONETARY ;; esac
        case ${12} in x*) LC_NUMERIC=${12#x}; export LC_NUMERIC ;; *) unset LC_NUMERIC ;; esac
        case ${13} in x*) LC_TIME=${13#x}; export LC_TIME ;; *) unset LC_TIME ;; esac
        case ${14} in x*) GIT_TIMEOUT=${14#x}; export GIT_TIMEOUT ;; *) unset GIT_TIMEOUT ;; esac
        shift 14
        GIT_CONFIG_NOSYSTEM=1
        export GIT_CONFIG_NOSYSTEM
        GIT_CONFIG_SYSTEM=/dev/null
        export GIT_CONFIG_SYSTEM
        GIT_CONFIG_GLOBAL=/dev/null
        export GIT_CONFIG_GLOBAL
        GIT_ATTR_NOSYSTEM=1
        export GIT_ATTR_NOSYSTEM
        project=$1
        shift
        if [ -n "${GIT_TIMEOUT-}" ]; then
            exec timeout --kill-after=5 "$GIT_TIMEOUT" git --no-optional-locks -c core.fsmonitor=false -c core.hooksPath=/dev/null -c core.excludesFile=/dev/null -c core.attributesFile=/dev/null -C "$project" "$@"
        fi
        exec git --no-optional-locks -c core.fsmonitor=false -c core.hooksPath=/dev/null -c core.excludesFile=/dev/null -c core.attributesFile=/dev/null -C "$project" "$@"
    ' git_in \
        "${PATH+x}${PATH-}" "${HOME+x}${HOME-}" "${XDG_CONFIG_HOME+x}${XDG_CONFIG_HOME-}" "${TMPDIR+x}${TMPDIR-}" \
        "${LANG+x}${LANG-}" "${LANGUAGE+x}${LANGUAGE-}" "${LC_ALL+x}${LC_ALL-}" "${LC_COLLATE+x}${LC_COLLATE-}" \
        "${LC_CTYPE+x}${LC_CTYPE-}" "${LC_MESSAGES+x}${LC_MESSAGES-}" "${LC_MONETARY+x}${LC_MONETARY-}" \
        "${LC_NUMERIC+x}${LC_NUMERIC-}" "${LC_TIME+x}${LC_TIME-}" "${GIT_TIMEOUT+x}${GIT_TIMEOUT-}" "$PROJECT" "$@"
}

in_work_tree() {
    inside=$(git_in rev-parse --is-inside-work-tree 2>/dev/null) || return 1
    [ "$inside" = true ] || return 1
    prefix=$(git_in rev-parse --show-prefix 2>/dev/null) || return 1
    [ -z "$prefix" ]
}

git_filter_drivers() {
    git_in config --get-regexp '^filter\..*\.(clean|smudge|process|required)$' 2>/dev/null |
        awk '{ name = $1; sub(/^filter\./, "", name); sub(/\.(clean|smudge|process|required)$/, "", name); print name }' |
        LC_ALL=C sort -u
}

git_index_flags_state() {
    index_file=$1
    index_hex=$2
    od -A n -v -t x1 "$index_file" >"$index_hex" 2>/dev/null || return 2
    awk '
        BEGIN { record_length=0; dirty=0; invalid=0 }
        {
            for (i=1; i<=NF; i++) {
                byte=$i
                if (byte == "00") {
                    if (record_length < 3 || separator != "20" || tag !~ /^(4[1-9a-f]|5[0-9a]|6[1-9a-f]|7[0-9a])$/) {
                        invalid=1
                    } else if (tag != "48") {
                        dirty=1
                    }
                    record_length=0
                    tag=""
                    separator=""
                } else {
                    if (record_length == 0) tag=byte
                    else if (record_length == 1) separator=byte
                    record_length++
                }
            }
        }
        END {
            if (invalid || record_length != 0) exit 2
            if (dirty) exit 1
            exit 0
        }
    ' "$index_hex"
}

path_or_ancestor_writable() {
    candidate=$1
    top=${2:-$HOOK_TOP}
    while :; do
        [ -w "$candidate" ] && return 0
        [ "$candidate" = "$top" ] && return 1
        parent=${candidate%/*}
        [ -n "$parent" ] || parent=/
        [ "$parent" != "$candidate" ] || return 1
        candidate=$parent
    done
}

physical_path() {
    candidate=$1
    hops=0
    while [ -L "$candidate" ]; do
        hops=$((hops + 1))
        [ "$hops" -le 40 ] || return 1
        target=$(readlink "$candidate") || return 1
        case $target in
            /*) candidate=$target ;;
            *) candidate=$(dirname "$candidate")/$target ;;
        esac
    done
    parent=$(
        unset CDPATH
        cd -P "$(dirname "$candidate")" 2>/dev/null && pwd -P
    ) || return 1
    printf '%s/%s\n' "${parent%/}" "${candidate##*/}"
}

proc_args() {
    [ -r "/proc/$1/cmdline" ] || return 1
    { tr '\0' ' ' <"/proc/$1/cmdline"; } 2>/dev/null | sed 's/ *$//' | cut -c1-200
}

proc_comm() {
    comm=$(sed -n 's/^[0-9]* (\(.*\)) [^)]*$/\1/p' "/proc/$1/stat" 2>/dev/null)
    [ -n "$comm" ] || return 1
    echo "$comm"
}

proc_stat() {
    [ -r "/proc/$1/stat" ] || return 1
    stat_line=$(sed 's/^.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $2, $4, $20, $5}')
    [ -n "$stat_line" ] || return 1
    echo "$stat_line"
}

proc_arg() {
    { tr '\0' '\n' <"/proc/$1/cmdline"; } 2>/dev/null | sed -n "$2p" | cut -c1-200
}

proc_uid() {
    sed -n 's/^Uid:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "/proc/$1/status" 2>/dev/null
}

proc_script_identity() {
    script_pid=$1
    [ "$(proc_comm "$script_pid")" = "${START_BIN##*/}" ] || return 1
    script_head=$(head -c 256 "$START_BIN" 2>/dev/null | sed -n 1p)
    case $script_head in
        '#!'*) ;;
        *) return 1 ;;
    esac
    script_interp=$(printf '%s\n' "${script_head#\#!}" | awk '{print $1}')
    [ -n "$script_interp" ] || return 1
    script_interp_path=$(physical_path "$script_interp") || return 1
    [ "$identity_exe" = "$script_interp_path" ] || return 1
    script_interp_arg=$(printf '%s\n' "${script_head#\#!}" | awk '{print $2}')
    if [ -n "$script_interp_arg" ]; then
        [ "$(proc_arg "$script_pid" 2)" = "$script_interp_arg" ] || return 1
        [ "$(proc_arg "$script_pid" 3)" = "$START_BIN" ] || return 1
    else
        [ "$(proc_arg "$script_pid" 2)" = "$START_BIN" ] || return 1
    fi
}

proc_identity() {
    identity_pid=$1
    identity_reject=executable
    identity_exe=$(readlink "/proc/$identity_pid/exe" 2>/dev/null) || return 1
    case $identity_exe in
        /*) ;;
        *) return 1 ;;
    esac
    case $identity_exe in
        *' (deleted)') return 1 ;;
    esac
    identity_uid=$(proc_uid "$identity_pid")
    case $identity_uid in
        '' | *[!0-9]*) return 1 ;;
    esac
    if [ -z "$probe_uid" ] || [ "$identity_uid" != "$probe_uid" ]; then
        identity_reject=uid
        return 1
    fi
    if [ "$identity_exe" = "$START_BIN" ]; then
        return 0
    fi
    proc_script_identity "$identity_pid"
}

proc_environ() {
    { cat "/proc/$1/environ"; } 2>/dev/null
}

environ_state() {
    if { true <"/proc/$1/environ"; } 2>/dev/null; then
        echo read
    else
        echo denied
    fi
}

tty_name() {
    [ "$1" -ne 0 ] || return 1
    major=$((($1 >> 8) & 4095))
    minor=$((($1 & 255) | (($1 >> 12) & 1048320)))
    case $major in
        13[6-9] | 14[0-3]) echo "/dev/pts/$((minor + (major - 136) * 256))" ;;
        229) echo "/dev/hvc$minor" ;;
        *) echo "tty:$major:$minor" ;;
    esac
}

proc_json() {
    pid=$1
    stat_line=$(proc_stat "$pid") || return 1
    read -r ppid sid ticks ttynr <<EOF
$stat_line
EOF
    comm=$(proc_comm "$pid") || return 1
    tty=$(tty_name "$ttynr") || tty=
    jq -cn \
        --argjson pid "$pid" --argjson ppid "$ppid" --argjson sid "$sid" --argjson ticks "$ticks" \
        --arg comm "$comm" --arg tty "$tty" \
        "$JQN"'{pid: $pid, ppid: $ppid, sid: $sid, comm: $comm, start_ticks: $ticks, tty: ($tty | n)}'
}

read_run_state() {
    run_state=
    [ -f "$RUN_STATE_FILE" ] && [ ! -L "$RUN_STATE_FILE" ] || return 0
    if ! timeout 2 dd if="$RUN_STATE_FILE" of="$work/run-state.raw" bs=65 count=1 iflag=nonblock,nofollow 2>/dev/null; then
        return 0
    fi
    [ -f "$RUN_STATE_FILE" ] && [ ! -L "$RUN_STATE_FILE" ] || return 0
    state_size=$(wc -c <"$work/run-state.raw" 2>/dev/null) || return 0
    state_size=$(printf '%s' "$state_size" | tr -d '[:space:]')
    case $state_size in
        '' | *[!0-9]*) return 0 ;;
    esac
    state_prefix=$(head -c 7 "$work/run-state.raw" 2>/dev/null) || state_prefix=
    state_nuls=$(LC_ALL=C tr -cd '\000' <"$work/run-state.raw" | wc -c | tr -d ' ')
    if [ "$state_size" -gt 64 ] || [ "$state_nuls" -ne 0 ]; then
        case $state_prefix in
            running*) run_state='running invalid' ;;
            exited*) run_state='exited invalid' ;;
            waiting*) run_state='waiting invalid' ;;
        esac
        return 0
    fi
    run_state=$(LC_ALL=C awk '
        function valid(s, attempt, fields, count) {
            if (s == "waiting") return 1
            if (s ~ /^running [1-9][0-9]*$/) {
                attempt = substr(s, 9)
                return length(attempt) <= 18
            }
            if (s ~ /^exited [1-9][0-9]* (0|[1-9][0-9]*)$/) {
                count = split(s, fields, " ")
                return count == 3 && length(fields[2]) <= 18 && length(fields[3]) <= 3 && fields[3] + 0 <= 255
            }
            return 0
        }
        NR == 1 { first = $0; next }
        { extra = 1 }
        END {
            if (NR == 1 && !extra && valid(first)) print first
            else if (first ~ /^running/) print "running invalid"
            else if (first ~ /^exited/) print "exited invalid"
            else if (first == "waiting") print "waiting invalid"
        }' "$work/run-state.raw" 2>/dev/null) || run_state=
}

collect_processes() {
    boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null) || boot_id=
    read_run_state
    main_pid=
    main_count=0
    main_pids=
    main_rejected_exe=0
    main_rejected_uid=0
    probe_uid=$(id -u 2>/dev/null) || probe_uid=
    : >"$work/main.matches"
    for dir in /proc/[0-9]*; do
        pid=${dir#/proc/}
        args=$(proc_args "$pid") || continue
        case $args in
            *"$START_BIN"*) ;;
            *) continue ;;
        esac
        stat_line=$(proc_stat "$pid") || continue
        read -r ppid _ _ <<EOF
$stat_line
EOF
        if parent=$(proc_args "$ppid"); then
            case $parent in
                *"$START_BIN"*) continue ;;
            esac
        fi
        if proc_identity "$pid"; then
            printf '%s\n' "$pid" >>"$work/main.matches"
        elif [ "$identity_reject" = uid ]; then
            main_rejected_uid=$((main_rejected_uid + 1))
        else
            main_rejected_exe=$((main_rejected_exe + 1))
        fi
    done
    if [ -s "$work/main.matches" ]; then
        main_count=$(wc -l <"$work/main.matches" | tr -d ' ')
        main_pids=$(sort -n "$work/main.matches" | tr '\n' ' ')
        main_pids=${main_pids% }
        main_pid=${main_pids%% *}
    fi
    self_pid=$$
    : >"$work/main.json"
    : >"$work/agent.ndjson"
    if [ -n "$main_pid" ]; then
        proc_json "$main_pid" >"$work/main.json"
        for dir in /proc/[0-9]*; do
            pid=${dir#/proc/}
            stat_line=$(proc_stat "$pid") || continue
            read -r ppid _ <<EOF
$stat_line
EOF
            [ "$ppid" = "$main_pid" ] || continue
            [ "$(proc_comm "$pid")" = "$AGENT_COMM" ] || continue
            proc_json "$pid" >>"$work/agent.ndjson"
        done
    fi
    proc_json "$self_pid" >"$work/self.json"
    descends=false
    cur=$self_pid
    while [ "$cur" -gt 1 ]; do
        stat_line=$(proc_stat "$cur") || break
        read -r cur _ <<EOF
$stat_line
EOF
        if [ -n "$main_pid" ] && [ "$cur" = "$main_pid" ]; then
            descends=true
            break
        fi
    done
    jq -n --arg boot_id "$boot_id" --arg run_state "$run_state" --argjson descends "$descends" \
        --slurpfile main "$work/main.json" --slurpfile agent "$work/agent.ndjson" --slurpfile self "$work/self.json" \
        "$JQN"'{boot_id: $boot_id, run_state: ($run_state | n), main: ($main[0] // null), agent: $agent,
          self: $self[0], self_descends_from_main: $descends}' >"$work/processes.json"
}

process_checks() {
    main_pid=$(jq -r '.main.pid // empty' "$work/processes.json")
    state=$(jq -r '.run_state // ""' "$work/processes.json")
    agent_count=$(jq -r '.agent | length' "$work/processes.json")
    if [ "$main_count" -eq 1 ]; then
        pass main_process "pid $main_pid verified as $START_BIN"
    elif [ "$main_count" -gt 1 ]; then
        fail main_process "$main_count top-level processes verify as $START_BIN (pids $main_pids); unexpected multiplicity is not a pass"
    elif [ "$main_rejected_exe" -gt 0 ] || [ "$main_rejected_uid" -gt 0 ]; then
        fail main_process "no process runs $START_BIN; rejected argv matches: executable=$main_rejected_exe uid=$main_rejected_uid"
    else
        fail main_process "no process runs $START_BIN"
    fi
    run_state=$state
    case $state in
        running*)
            if ! run_state_attempt >/dev/null; then
                fail agent_child "the lifecycle state '$state' is not a valid running state: expected 'running <attempt>'"
            elif [ "$agent_count" -eq 1 ]; then
                pass agent_child "1 Codex process as a child of the main process"
            elif [ "$agent_count" -gt 1 ]; then
                fail agent_child "$agent_count Codex processes are children of the main process, expected one"
            else
                fail agent_child "state is $state but the main process has no Codex child"
            fi
            ;;
        *) skip agent_child "jackin-start state is '${state:-unknown}', not running" ;;
    esac
}

agent_tool_evidence() {
    : >"$work/tool.out"
    : >"$work/tool.observation"
    tool_attempted=false
    tool_succeeded=false
    tool_exit=
    actual_provider=
    actual_model=
    actual_endpoint=
    configs_stat_ok=true
    configs_pinned=false
    sandbox_endpoint=
    sandbox_conflict=false
    if [ "$EXPECTED_AGENT" = codex ]; then
        if endpoint_value=$(provider_endpoint "$work/agent-home/config.toml" "$EXPECTED_PROVIDER" 2>/dev/null); then
            actual_endpoint=$endpoint_value
        fi
        if endpoint_value=$(provider_endpoint "${AUTH_FILE%/*}/config.toml" "$EXPECTED_PROVIDER" 2>/dev/null); then
            sandbox_endpoint=$endpoint_value
        else
            sandbox_conflict=true
        fi
    else
        declared_use_snapshot=1
        if [ "${prompt_configs_validated-}" = true ] && declared_provider_config; then
            actual_endpoint=$declared_effective
        fi
    fi
    tool_workdir=
    if [ "$launch_kind" != none ]; then
        set --
        while IFS= read -r encoded; do
            [ -n "$encoded" ] || continue
            arg=$(printf '%s' "$encoded" | base64 -d) || return 65
            set -- "$@" "$arg"
        done <<EOF
$TOOL_ARGV
EOF
        if [ "${prompt_configs_validated-}" = true ] && [ "${prompt_configs_pinned-}" = true ]; then
            configs_pinned=true
        fi
        if [ "$configs_pinned" = true ]; then
            (
                ulimit -f 128
                cd "$PROJECT" || exit 1
                sanitize_launch_environment || exit 1
                CODEX_HOME="$work/agent-home" timeout --kill-after=5 240 "$@" >"$work/tool.out" 2>/dev/null </dev/null
            )
            tool_exit=$?
        else
            tool_exit=126
        fi
        if [ "$configs_pinned" = true ]; then
            declared_configs_stat_unchanged || configs_stat_ok=false
            unpin_declared_configs
        fi
        events=$(jq -Rs '[split("\n")[] | select(length > 0) | fromjson?]' "$work/tool.out" 2>/dev/null) || events='[]'
        actual_provider=$(printf '%s' "$events" | jq -r '[.. | objects | .provider? // .provider_name? // .model_provider? // empty | select(type == "string" and length > 0)] | .[0] // ""')
        actual_model=$(printf '%s' "$events" | jq -r '[.. | objects | .model? // .canonicalModel? // (.modelUsage? | if type == "object" then keys[] else empty end) // empty | select(type == "string" and length > 0)] | .[0] // ""')
        case $ADAPTER in
            t01-codex-v1 | t18-codex-zai-v1)
                tool_attempted=$(printf '%s' "$events" | jq -r 'any(.. | objects; .type? == "exec_command_begin")')
                tool_result=$(printf '%s' "$events" | jq -r 'any(.. | objects; .type? == "exec_command_end" and .exit_code? == 0)')
                ;;
            t09-omp-zai-v1)
                tool_attempted=$(printf '%s' "$events" | jq -r --arg kind "$TOOL_KIND" 'any(.. | objects; .type? == "tool_call" and (.name? == $kind or .toolName? == $kind))')
                tool_result=$(printf '%s' "$events" | jq -r 'any(.. | objects; .type? == "tool_result" and .isError? == false)')
                ;;
            t14-claude-zai-v1)
                tool_attempted=$(printf '%s' "$events" | jq -r --arg kind "$TOOL_KIND" 'any(.. | objects; .type? == "tool_use" and .name? == $kind)')
                tool_result=$(printf '%s' "$events" | jq -r 'any(.. | objects; .type? == "tool_result" and .is_error? == false)')
                ;;
            *) tool_result=false ;;
        esac
        tool_workdir=$(printf '%s' "$events" | jq -r '[.. | objects | .workdir? // .cwd? // empty | select(type == "string" and length > 0)] | .[0] // ""')
        [ -n "$tool_workdir" ] || tool_workdir=$PROJECT
        tool_answered=$(printf '%s' "$events" | jq -r 'any(.. | strings; ascii_downcase | gsub("^\\s+|\\s+$"; "") == "ready")')
        if [ "$tool_attempted" = true ] && [ "$tool_result" = true ] && [ "$tool_exit" -eq 0 ] && [ "$tool_answered" = true ]; then
            tool_succeeded=true
        fi
        while IFS= read -r encoded; do
            [ -n "$encoded" ] || continue
            entry=$(printf '%s' "$encoded" | base64 -d) || return 65
            if [ "$tool_succeeded" = true ] && grep -Fq -- "$entry" "$work/tool.out"; then
                printf '%s\n' "$entry" >>"$work/tool.observation"
            fi
        done <<EOF
$TOOL_OBSERVATION
EOF
    fi
    if [ "$EXPECTED_AGENT" = codex ]; then
        if [ -n "$stage_config_stat" ] || [ -e "$work/agent-home/config.toml" ]; then
            stage_stat_now=$(python3 -I -c 'import os, sys; s = os.stat(sys.argv[1]); sys.stdout.write("%d %d %d %d %d" % (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns))' "$work/agent-home/config.toml" 2>/dev/null) || stage_stat_now=
            [ -n "$stage_config_stat" ] && [ "$stage_stat_now" = "$stage_config_stat" ] || sandbox_conflict=true
        fi
        if [ "$configs_pinned" != true ]; then
            actual_endpoint=
            sandbox_conflict=true
        elif [ "$configs_stat_ok" != true ] || ! declared_configs_match_snapshot; then
            actual_endpoint=
        fi
    elif [ -n "$actual_endpoint" ]; then
        declared_use_snapshot=1
        declared_provider_config || actual_endpoint=
        declared_use_snapshot=
        if [ -n "$actual_endpoint" ] && { [ "$configs_stat_ok" != true ] || ! declared_configs_match_snapshot; }; then
            actual_endpoint=
        fi
    fi
    observation=$(jq -Rn '[inputs]' <"$work/tool.observation")
    jq -cn --arg provider "$actual_provider" --arg model "$actual_model" --arg kind "$TOOL_KIND" \
        --arg endpoint "$actual_endpoint" --arg sandbox "$sandbox_endpoint" --argjson conflict "$sandbox_conflict" \
        --argjson attempted "$tool_attempted" --argjson succeeded "$tool_succeeded" --arg exit_code "$tool_exit" \
        --arg workdir "$tool_workdir" --argjson observation "$observation" \
        "$JQN"'{actual_provider: $provider, actual_model: $model, actual_endpoint: $endpoint,
          sandbox_endpoint: (if $conflict then null else $sandbox end),
          tool: {kind: $kind, attempted: $attempted, succeeded: $succeeded,
                 exit_code: ($exit_code | n | if . == null then null else tonumber end),
                 workdir: $workdir, observation: $observation}}'
}

read_bounded() {
    read_src=$1
    read_dst=$2
    read_cap=$3
    [ -f "$read_src" ] || return 1
    if [ -L "$read_src" ]; then
        return 1
    fi
    read_bytes=
    if command -v head >/dev/null 2>&1; then
        if command -v timeout >/dev/null 2>&1; then
            timeout 10 head -c $((read_cap + 1)) -- "$read_src" >"$read_dst" 2>/dev/null || return 1
        else
            head -c $((read_cap + 1)) -- "$read_src" >"$read_dst" 2>/dev/null || return 1
        fi
    else
        if command -v dd >/dev/null 2>&1; then
            dd if="$read_src" of="$read_dst" bs="$((read_cap + 1))" count=1 2>/dev/null || return 1
        else
            return 1
        fi
    fi
    [ -f "$read_dst" ] || return 1
    if command -v wc >/dev/null 2>&1; then
        read_bytes=$(wc -c <"$read_dst" 2>/dev/null | tr -d '[:space:]') || return 1
    else
        read_bytes=$(jq -Rrn --rawfile d "$read_dst" '$d | utf8bytelength' 2>/dev/null) || return 1
    fi
    case $read_bytes in
        '' | *[!0-9]*) return 1 ;;
    esac
    [ "$read_bytes" -le "$read_cap" ] || return 1
    [ -f "$read_src" ] || return 1
    if [ -L "$read_src" ]; then
        return 1
    fi
    return 0
}

copy_bounded() {
    read_bounded "$1" "$2" "$AGENT_HOME_MAX_BYTES"
}

declared_provider_config() {
