step_J00() (
    present=false
    executable=false
    version=
    [ -e "$AGENT_BIN" ] && present=true
    if [ -f "$AGENT_BIN" ] && [ -x "$AGENT_BIN" ]; then
        executable=true
    fi
    if [ "$executable" = true ]; then
