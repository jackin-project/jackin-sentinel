    fi
    main_known=0
    agent_known=0
    if [ "$record_state" = read ]; then
        main_known=1
        agent_lines=$(awk -F'\t' '$1 == "agent"' "$work/record.tsv" | wc -l | tr -d ' ')
        if [ "$record_attempt" -ge 1 ]; then
            case $run_state in
                'exited '*' 65') [ "$agent_lines" -eq 0 ] || agent_known=1 ;;
                *) agent_known=1 ;;
            esac
        fi
    fi
    main_env=$(agent_env main "$work/live.main.tsv" "$main_pid")
    agent_env=absent
