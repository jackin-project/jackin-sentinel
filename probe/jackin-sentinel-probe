        _jks_docker_info_capture_status=0
        if _jks_docker_info_capture=$(docker_capture 60 stdout docker info --format '{{.ID}} {{.ServerVersion}}'); then
            :
        else
            _jks_docker_info_capture_status=$?
        fi
        _jks_docker_info_parse_status=0
        _jks_docker_info_parsed=
        if _jks_docker_info_parsed=$(printf '%s' "$_jks_docker_info_capture" | docker_capture_result "$_jks_docker_info_capture_status" info); then
            :
