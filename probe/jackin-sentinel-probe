                [ -n "$declared_parsed" ] || return 1
                ;;
            *) return 1 ;;
        esac
        if [ -z "$declared_effective" ]; then
            declared_effective=$declared_parsed
        elif [ "$declared_effective" != "$declared_parsed" ]; then
            return 1
        fi
        declared_index=$((declared_index + 1))
    done
    [ -n "$declared_effective" ] || return 1
    return 0
}

pin_declared_configs() {
    PIN_MODES=
    PIN_STATS=
    pin_declared_configs_run || {
        unpin_declared_configs
        return 1
    }
    return 0
}

pin_declared_configs_run() {
    command -v chmod >/dev/null 2>&1 || return 1
    declared_count=$(printf '%s\n' "$SPEC_JSON" | jq -r '.behavior.credential.config_files // [] | length') || return 1
    declared_index=0
    while [ "$declared_index" -lt "$declared_count" ]; do
        declared_path=$(printf '%s\n' "$SPEC_JSON" | jq -r --argjson i "$declared_index" '.behavior.credential.config_files[$i].path') || return 1
        case $declared_index in
            0) _jks_vcfg_sel=${_jks_vcfg_0-} ;;
            1) _jks_vcfg_sel=${_jks_vcfg_1-} ;;
            *) return 1 ;;
        esac
        [ -n "$_jks_vcfg_sel" ] || return 1
        declared_mode=$(python3 -I -c 'import os, sys; sys.stdout.write(oct(os.stat(sys.argv[1]).st_mode & 0o7777)[2:])' "$declared_path" 2>/dev/null) || return 1
        case $declared_mode in
            '' | *[!0-7]*) return 1 ;;
        esac
        PIN_MODES="${PIN_MODES}${declared_mode}
"
        chmod 0644 "$declared_path" 2>/dev/null || true
        printf '%s' "$_jks_vcfg_sel" >"$declared_path" || return 1
        chmod 0444 "$declared_path" || return 1
        declared_stat=$(python3 -I -c 'import os, sys; s = os.stat(sys.argv[1]); sys.stdout.write("%d %d %d %d %d" % (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns))' "$declared_path" 2>/dev/null) || return 1
        PIN_STATS="${PIN_STATS}${declared_stat}
"
        declared_index=$((declared_index + 1))
    done
    return 0
}

unpin_declared_configs() {
    [ -n "${PIN_MODES-}" ] || return 0
    declared_count=$(printf '%s\n' "$SPEC_JSON" | jq -r '.behavior.credential.config_files // [] | length') || return 0
    declared_index=0
    while [ "$declared_index" -lt "$declared_count" ]; do
        declared_path=$(printf '%s\n' "$SPEC_JSON" | jq -r --argjson i "$declared_index" '.behavior.credential.config_files[$i].path') || return 0
        declared_mode=$(printf '%s\n' "$PIN_MODES" | sed -n "$((declared_index + 1))p")
        case $declared_mode in
            '' | *[!0-7]*)
                declared_index=$((declared_index + 1))
                continue
                ;;
        esac
        chmod "$declared_mode" "$declared_path" 2>/dev/null || true
        declared_index=$((declared_index + 1))
    done
    PIN_MODES=
    return 0
}

declared_configs_match_snapshot() {
    declared_count=$(printf '%s\n' "$SPEC_JSON" | jq -r '.behavior.credential.config_files // [] | length') || return 1
    declared_index=0
    while [ "$declared_index" -lt "$declared_count" ]; do
        declared_path=$(printf '%s\n' "$SPEC_JSON" | jq -r --argjson i "$declared_index" '.behavior.credential.config_files[$i].path') || return 1
        case $declared_index in
            0) _jks_vcfg_sel=${_jks_vcfg_0-} ;;
            1) _jks_vcfg_sel=${_jks_vcfg_1-} ;;
            *) return 1 ;;
        esac
        [ -n "$_jks_vcfg_sel" ] || return 1
        read_bounded "$declared_path" "$spec_dir/config.livecheck" "$CONFIG_BYTE_CAP" || return 1
        _jks_live=$(
            cat "$spec_dir/config.livecheck"
            printf x
        ) || return 1
        _jks_live=${_jks_live%x}
        [ "$_jks_live" = "$_jks_vcfg_sel" ] || return 1
        declared_index=$((declared_index + 1))
    done
    return 0
}

declared_configs_stat_unchanged() {
    stat_count=$(printf '%s\n' "$SPEC_JSON" | jq -r '.behavior.credential.config_files // [] | length') || return 1
    stat_index=0
    while [ "$stat_index" -lt "$stat_count" ]; do
        stat_path=$(printf '%s\n' "$SPEC_JSON" | jq -r --argjson i "$stat_index" '.behavior.credential.config_files[$i].path') || return 1
        [ -n "$stat_path" ] || return 1
        stat_now=$(python3 -I -c 'import os, sys; s = os.stat(sys.argv[1]); sys.stdout.write("%d %d %d %d %d" % (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns))' "$stat_path" 2>/dev/null) || return 1
        stat_pinned=$(printf '%s\n' "$PIN_STATS" | sed -n "$((stat_index + 1))p")
        [ -n "$stat_pinned" ] || return 1
        [ "$stat_now" = "$stat_pinned" ] || return 1
        stat_index=$((stat_index + 1))
    done
    return 0
}

provider_endpoint() {
    endpoint_file=$1
    endpoint_provider=$2
    [ -f "$endpoint_file" ] || return 0
    case $endpoint_provider in
        '' | *[!A-Za-z0-9_-]*) return 1 ;;
    esac
    endpoint_value=$(jq -Rrs --arg want "$endpoint_provider" \
        'def toml_unesc:
  explode
  | reduce .[] as $c ({o: "", s: 0, h: "", n: 0, f: 0};
      if .s == 0 then
        (if .f == 1 then (if ([9, 10, 13, 32] | index($c)) == null then .f = 0 | .o += ([$c] | implode) else . end)
         elif $c == 92 then .s = 1 else .o += ([$c] | implode) end)
      elif .s == 1 then
        (if $c == 117 then .s = 2 | .h = "" | .n = 4
         elif $c == 85 then .s = 2 | .h = "" | .n = 8
         elif $c == 10 then .s = 0 | .f = 1
         elif ([98, 116, 110, 102, 114, 34, 92] | index($c)) == null then .s = -1
         else .o += (if $c == 98 then "\b" elif $c == 116 then "\t" elif $c == 110 then "\n" elif $c == 102 then "\f" elif $c == 114 then "\r" elif $c == 34 then "\"" else "\\" end) | .s = 0 end)
      elif .s == 2 then
        ("0123456789abcdef" | index(([$c] | implode | ascii_downcase))) as $v
        | if $v == null then .s = -1
          else .h += ([$c] | implode) | .n -= 1
            | if .n == 0 then
                .s = 0
                | .o += ([.h | explode | reduce .[] as $d (0; . * 16 + ("0123456789abcdef" | index(([$d] | implode | ascii_downcase))))] | implode)
              else . end
          end
      else . end)
  | if .s == 0 then .o else null end;
def outline:
    split("\n") | map(sub("\r$"; "")) as $lines
    | reduce range(0; $lines | length) as $i ({state: "out", skip: 0, drop: 0, out: [], code: "", lits: [], lit: null, fresh: false};
        ($lines[$i] | explode) as $cs
        | reduce range(0; $cs | length) as $j (.;
            if .skip > 0 then
                .skip -= 1
                | (if .drop > 0 then .drop -= 1
                    elif .lit != null then .lit += ([$cs[$j]] | implode)
                    else .code += " " end)
            else
                (([$cs[$j], ($cs[$j + 1] // -1), ($cs[$j + 2] // -1)] | map(if . == -1 then "" else ([.] | implode) end) | join("")) as $t3
                 | ([$cs[$j]] | implode) as $c
                 | if .state == "out" then
                       (if $t3 == "\"\"\"" then .state = "mlb" | .skip = 2 | .drop = 2 | .code += "   " | .lit = "" | .fresh = true
                        elif $t3 == "'"'"''"'"''"'"'" then .state = "mll" | .skip = 2 | .drop = 2 | .code += "   " | .lit = "" | .fresh = true
                        elif $c == "\"" then .state = "bs" | .code += " " | .lit = ""
                        elif $c == "'"'"'" then .state = "ls" | .code += " " | .lit = ""
                        elif $c == "#" then .skip = ($cs | length) - $j - 1 | .code += " "
                        else .code += $c end)
                   elif .state == "bs" then
                       (if $c == "\"" then .state = "out" | .code += "\u0001" | .lits += [(.lit | toml_unesc)] | .lit = null
                        elif $c == "\\" then .skip = 1 | .lit += $c
                        else .lit += $c end)
                   elif .state == "ls" then
                       (if $c == "'"'"'" then .state = "out" | .code += "\u0001" | .lits += [.lit] | .lit = null
                        else .lit += $c end)
                   elif .state == "mlb" then
                       (if $t3 == "\"\"\"" then
                            ([$cs[$j:][]] | implode | capture("^(?<run>\"*)").run | length) as $run
                            | .state = "out" | .skip = ($run - 1) | .code += ("\u0001" + (" " * ($run - 1)))
                            | .lit += ("\"" * ($run - 3)) | .lits += [(.lit | toml_unesc)] | .lit = null | .fresh = false
                        elif $c == "\\" then .skip = 1 | .lit += $c
                        else .lit += $c end)
                   else
                       (if $t3 == "'"'"''"'"''"'"'" then
                            ([$cs[$j:][]] | implode | capture("^(?<run>'"'"'*)").run | length) as $run
                            | .state = "out" | .skip = ($run - 1) | .code += ("\u0001" + (" " * ($run - 1)))
                            | .lit += ("'"'"'" * ($run - 3)) | .lits += [.lit] | .lit = null | .fresh = false
                        else .lit += $c end)
                   end)
            end)
        | (if .lit == null then (.out += [{code: .code, lits: .lits}] | .code = "" | .lits = [])
            elif .fresh and (.lit | length) == 0 then .fresh = false
            else .lit += "\n" | .fresh = false end)
        | .skip = 0 | .drop = 0)
    | .out;
. as $raw
| outline as $o
| [$o | to_entries[] | {i: .key, code: (.value.code | sub("^[ \t]+"; "") | sub("[ \t]+$"; "")), lits: .value.lits}] as $L
| [$L[] | select((.code | startswith("[") and endswith("]")))] as $headers
| [$headers[] | .lits as $hl | .i as $hi
    | (.code | sub("^\\["; "") | sub("\\]$"; "") | split(".")) as $segs
    | (reduce range(0; $segs | length) as $si ({n: 0, keys: [], bad: false};
        ($segs[$si] | sub("^[ \t]+"; "") | sub("[ \t]+$"; "")) as $k
        | if $k == "\u0001" then
            (if .n < ($hl | length) then .keys += [$hl[.n]] | .n += 1 else .bad = true end)
          elif (($k | length) == 0 or ($k | contains("\u0001"))) then .bad = true
          else .keys += [$k] end))
    | select((.bad | not) and .keys == ["model_providers", $want])
    | {i: $hi, keys: .keys}] as $tables
| (if ($tables | length) == 1 then ([$headers[] | select(.i > $tables[0].i) | .i] | .[0] // ([$L[] | .i] | length)) else 0 end) as $stop
| [$L[] | select(($tables | length) == 1 and .i > $tables[0].i and .i < $stop and (.code | test("^(base_url|\u0001)[ \t]*=")) and (if (.code | startswith("\u0001")) then ((.lits | length) >= 1 and .lits[0] == "base_url") else true end))] as $setters
| [$setters[] | select((.code | sub("^(base_url|\u0001)[ \t]*=[ \t]*"; "")) == "\u0001") | select((if (.code | startswith("\u0001")) then (.lits | length) == 2 else (.lits | length) == 1 end))] as $urls
| if ($tables | length) == 0 then ""
  elif ($tables | length) > 1 then "conflict"
  elif ($setters | length) > 1 then "conflict"
  elif ($setters | length) != ($urls | length) then "conflict"
  elif ($setters | length) == 0 then ""
  else ($setters[0].lits[-1] // "conflict") end' "$endpoint_file" 2>/dev/null) || return 1
    [ "$endpoint_value" = conflict ] && return 1
    printf '%s' "$endpoint_value"
}

stage_provider_config() {
    stage_target=$1
    [ "$EXPECTED_AGENT" = codex ] || return 0
    case $EXPECTED_PROVIDER in
        '' | *[!A-Za-z0-9_-]*) return 1 ;;
    esac
    printf '%s\n' "$SPEC_JSON" | jq -r --arg path "${AUTH_FILE%/*}/config.toml" --arg provider "$EXPECTED_PROVIDER" \
        --rawfile model /dev/fd/3 --arg endpoint "$PROVIDER_URL" '
        [.behavior.credential.config_files // [] | .[] | select(.path == $path) | (.required_text // [])[]] as $lines
        | ([$lines[] | select(test("^model_provider[[:space:]]*=")) | capture("^model_provider[[:space:]]*=[[:space:]]*\"(?<v>[^\"]*)\"[[:space:]]*$").v]) as $wired
        | if any($lines[]; test("^[[:space:]]*\\[") or test("[[:cntrl:]]")) then empty
        elif ($wired | length) > 1 or (($wired | length) == 1 and $wired[0] != $provider) then empty
        else
            ([$lines[] | select(test("^(model|model_provider)[[:space:]]*="))]) as $top
            | ([$lines[] | select(test("^(model|model_provider)[[:space:]]*=") | not)]) as $table
            | (if ($top | length) == 0 then ["model = " + (($model | rtrimstr("\n")) | tojson), "model_provider = " + ($provider | tojson)] else $top end) as $top
            | (if ($table | length) == 0 then ["name = " + ($provider | tojson), "base_url = " + ($endpoint | tojson)] else $table end) as $table
            | $top[], "", "[model_providers." + $provider + "]", $table[]
        end' >"$stage_target" 2>/dev/null 3<<EOF_JKS_EXPECTED_MODEL || return 1
$EXPECTED_MODEL
EOF_JKS_EXPECTED_MODEL
    [ -s "$stage_target" ] || return 1
}

stage_agent_home() {
    stage_dir=$work/agent-home
    rm -rf "$stage_dir" 2>/dev/null || return 1
    mkdir -p "$stage_dir" 2>/dev/null || return 1
    if [ -e "$AUTH_FILE" ] || [ -L "$AUTH_FILE" ]; then
        [ -f "$AUTH_FILE" ] || return 1
        stage_name=${AUTH_FILE##*/}
        case $stage_name in
            '' | . | ..) return 1 ;;
        esac
        copy_bounded "$AUTH_FILE" "$stage_dir/$stage_name" || return 1
    fi
    stage_provider_config "$stage_dir/config.toml" || return 1
    stage_config_stat=
    if [ -f "$stage_dir/config.toml" ]; then
        chmod 0444 "$stage_dir/config.toml" 2>/dev/null || return 1
        stage_config_stat=$(python3 -I -c 'import os, sys; s = os.stat(sys.argv[1]); sys.stdout.write("%d %d %d %d %d" % (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns))' "$stage_dir/config.toml" 2>/dev/null) || return 1
    fi
    return 0
}

agent_exec_seal() {
    _jks_agent_exec_seal=$(printf '%s%s\n' "$RUN_KEY" "$_jks_agent_exec_doc" | sha256sum 2>/dev/null) || return 1
    _jks_agent_exec_seal=${_jks_agent_exec_seal%% *}
    printf '%s\n' "$_jks_agent_exec_seal" >"$work/agent_exec.seal" || return 1
    return 0
}

agent_exec_verified() {
    [ -f "$work/agent_exec.json" ] && [ -f "$work/agent_exec.seal" ] || return 1
    [ -n "$RUN_KEY" ] || return 1
    _jks_agent_exec_doc=$(cat "$work/agent_exec.json" 2>/dev/null) || return 1
    _jks_agent_exec_want=$(cat "$work/agent_exec.seal" 2>/dev/null) || return 1
    _jks_agent_exec_got=$(printf '%s%s\n' "$RUN_KEY" "$_jks_agent_exec_doc" | sha256sum 2>/dev/null) || return 1
    _jks_agent_exec_got=${_jks_agent_exec_got%% *}
    [ "$_jks_agent_exec_got" = "$_jks_agent_exec_want" ]
}

ensure_agent_exec() {
    [ -f "$work/agent_exec.json" ] && return 0
    launch_kind=none
    why="the sandbox holds no credential"
    if stage_agent_home; then
        staged=1
    else
        staged=0
    fi
    cred_path="$work/agent-home/${AUTH_FILE##*/}"
    unsafe=
    if [ -e "$cred_path" ] || [ -L "$cred_path" ]; then
        kinds=$(token_kinds "$cred_path") || kinds="other other other"
        case $kinds in
            *other*) unsafe=1 ;;
        esac
        if ! declared_fields=$(auth_file_fields "$cred_path"); then
            unsafe=1
        elif [ "$(printf '%s' "$declared_fields" | jq -r 'any(.[]; .kind == "other")')" = true ]; then
            unsafe=1
        fi
    fi
    login_ready=0
    api_ready=0
    static_ready=0
    has_other=0
    inspection_unavailable=
    env_inventory=$(
        exec 3>&1
        {
            producer_status=0
            env -0 3>&- 2>/dev/null || producer_status=$?
            printf '!P\t%s\n' "$producer_status" >&3
        } | {
            classifier_status=0
            classified=$(credential_variables agent_exec 3>&- 2>/dev/null) || classifier_status=$?
            if [ -n "$classified" ]; then
                printf '%s\n' "$classified" >&3
            fi
            printf '!C\t%s\n' "$classifier_status" >&3
        }
    )
    inventory_summary=$(printf '%s\n' "$env_inventory" | LC_ALL=C awk -F '\t' -v credential_env="$CREDENTIAL_ENV" -v credential_class="$CREDENTIAL_CLASS" '
        $1 == "!P" {
            if (NF != 2 || $2 !~ /^[0-9]+$/ || producer_seen++) invalid = 1
            else producer_status = $2
            next
        }
        $1 == "!C" {
            if (NF != 2 || $2 !~ /^[0-9]+$/ || classifier_seen++) invalid = 1
            else classifier_status = $2
            next
        }
        NF != 3 || $1 !~ /^[A-Za-z_][A-Za-z0-9_]*$/ ||
            ($2 != "empty" && $2 != "placeholder" && $2 != "other") || $3 != "agent_exec" {
            invalid = 1
            next
        }
        $2 == "other" && ($1 != credential_env || credential_class != "static_key") { other = 1 }
        credential_class == "static_key" && $1 == credential_env && $2 != "empty" { static = 1 }
        $1 == "CODEX_AUTH_ACCESS_TOKEN" && $2 == "placeholder" { login = 1 }
        $1 == "OPENAI_API_KEY" && $2 == "placeholder" { api = 1 }
        END {
            if (invalid || producer_seen != 1 || classifier_seen != 1) exit 2
            printf "%d %d %d %d %s %s\n", login, api, other, static, producer_status, classifier_status
        }
    ' 2>/dev/null) || inspection_unavailable=1
    [ "$RAW_CREDENTIAL" -eq 0 ] || unsafe=1
    if [ -z "$inspection_unavailable" ] && [ -n "$inventory_summary" ]; then
        extra=
        if read -r inventory_login_ready inventory_api_ready inventory_has_other inventory_static_ready producer_status classifier_status extra <<EOF
$inventory_summary
EOF
        then
            case "$inventory_login_ready:$inventory_api_ready:$inventory_has_other:$inventory_static_ready:${extra-}" in
                [01]:[01]:[01]:[01]:)
                    if [ "$producer_status" = 0 ] && [ "$classifier_status" = 0 ]; then
                        login_ready=$inventory_login_ready
                        api_ready=$inventory_api_ready
                        has_other=$inventory_has_other
                        static_ready=$inventory_static_ready
                    else
                        inspection_unavailable=1
                    fi
                    ;;
                *) inspection_unavailable=1 ;;
            esac
        else
            inspection_unavailable=1
        fi
    else
        inspection_unavailable=1
    fi
    [ "$has_other" = 0 ] || unsafe=1
    if [ "$staged" -eq 0 ]; then
        launch_kind=none
        why="codex exec was not run: could not stage the validated credential home"
    elif [ -n "$unsafe" ]; then
        why="codex exec was not run: the sandbox holds a credential that is not a full placeholder, and codex would send it"
    elif [ -n "$inspection_unavailable" ]; then
        why="codex exec was not run: could not inspect inherited credentials"
    elif [ "$CREDENTIAL_CLASS" = static_key ] && [ "$static_ready" = 1 ] && [ "$RAW_CREDENTIAL" -eq 0 ]; then
        launch_kind=static_key
    elif [ "$login_ready" = 1 ]; then
        launch_kind=oauth_login
    elif [ -f "$cred_path" ] && jq -e --arg re "$PLACEHOLDER_RE" '.tokens.access_token | type == "string" and test($re + "\\z")' "$cred_path" >/dev/null 2>&1; then
        launch_kind=oauth_login
    elif [ "$api_ready" = 1 ]; then
        launch_kind=api_key
    elif [ -f "$cred_path" ] && jq -e --arg re "$PLACEHOLDER_RE" '.OPENAI_API_KEY | type == "string" and test($re + "\\z")' "$cred_path" >/dev/null 2>&1; then
        launch_kind=api_key
    fi
    if [ "${prompt_configs_validated-}" != true ] || [ "${prompt_configs_pinned-}" != true ]; then
        config_gate_refused=1
        launch_kind=none
        why="codex exec was not run: the declared configuration was not validated and pinned"
    fi
    if [ "$launch_kind" != none ] && ! (sanitize_launch_environment); then
        launch_kind=none
        why="codex exec was not run: the probe could not build a sanitized environment for the launch"
    fi
    if [ "$launch_kind" = none ]; then
        rm -rf "$work/agent-home" 2>/dev/null
    fi
    printf '%s' "$why" >"$work/agent_exec.why"
    unset _jks_stdout_capture _jks_stdout_capture_status _jks_stdout_encoded _jks_stdout_producer_status
    unset _jks_stdout_od_status _jks_stdout_drain_status _jks_stdout_encoded_bytes _jks_stdout_count_status
    unset _jks_stdout_parsed _jks_stdout_parse_status _jks_stdout_parsed_exit _jks_stdout_parsed_bytes
    unset _jks_stdout_parsed_answer _jks_stdout_extra
    _jks_stdout_capture=
    attempted=false
    exit_code=
    answered=false
    bytes=0
    set --
    while IFS= read -r encoded; do
        [ -n "$encoded" ] || continue
        arg=$(printf '%s' "$encoded" | base64 -d) || return 65
        set -- "$@" "$arg"
    done <<EOF
$PROMPT_ARGV
EOF
    if [ "$launch_kind" != none ]; then
        attempted=true
        if _jks_stdout_capture=$(
            exec 3>&1 || exit 1
            (
                _jks_stdout_producer_status=0
                if (cd "$SCAN_ROOT" && sanitize_launch_environment && CODEX_HOME="$work/agent-home" timeout --kill-after=5 240 "$@" 3>&- 2>/dev/null </dev/null); then
                    :
                else
                    _jks_stdout_producer_status=$?
                fi
                printf '!P\t%s\n' "$_jks_stdout_producer_status" >&3 || exit 1
            ) | {
                _jks_stdout_od_status=0
                _jks_stdout_encoded=
                if _jks_stdout_encoded=$(LC_ALL=C timeout --kill-after=5 240 od -An -N65537 -v -tx1 3>&- 2>/dev/null); then
                    :
                else
                    _jks_stdout_od_status=$?
                fi
                _jks_stdout_drain_status=0
                timeout --kill-after=5 30 cat >/dev/null 3>&- 2>/dev/null || _jks_stdout_drain_status=$?
                if [ "$_jks_stdout_od_status" -ne 0 ] || [ "$_jks_stdout_drain_status" -ne 0 ]; then
                    _jks_stdout_count_status=0
                    _jks_stdout_encoded_bytes=
                    if _jks_stdout_encoded_bytes=$(printf '%s' "$_jks_stdout_encoded" | LC_ALL=C awk '
                        function valid_hex(value) {
                            return length(value) == 2 && value ~ /^[[:xdigit:]][[:xdigit:]]$/
                        }
                        {
                            line = $0
                            sub(/^[[:space:]]+/, "", line)
                            sub(/[[:space:]]+$/, "", line)
                            if (line == "") next
                            token_count = split(line, tokens, /[[:space:]]+/)
                            for (i = 1; i <= token_count; i++) {
                                if (valid_hex(tokens[i])) bytes++
                                else invalid = 1
                            }
                        }
                        END {
                            if (invalid || bytes > 65537) exit 1
                            printf "%d\n", bytes
                        }
                    ' 3>&- 2>/dev/null); then
                        :
                    else
                        _jks_stdout_count_status=$?
                    fi
                    if [ "$_jks_stdout_count_status" -ne 0 ]; then
                        unset _jks_stdout_encoded _jks_stdout_encoded_bytes _jks_stdout_count_status
                        unset _jks_stdout_od_status _jks_stdout_drain_status
                        exit 1
                    fi
                    unset _jks_stdout_encoded
                    if ! printf '!E\t%s\t%s\t%s\n' "$_jks_stdout_od_status" "$_jks_stdout_drain_status" "$_jks_stdout_encoded_bytes" >&3; then
                        unset _jks_stdout_encoded_bytes _jks_stdout_count_status
                        unset _jks_stdout_od_status _jks_stdout_drain_status
                        exit 1
                    fi
                    unset _jks_stdout_encoded_bytes _jks_stdout_count_status
                    unset _jks_stdout_od_status _jks_stdout_drain_status
                    exit 1
                fi
                if ! printf '!H\n%s\n!O\t%s\n!D\t%s\n' "$_jks_stdout_encoded" "$_jks_stdout_od_status" "$_jks_stdout_drain_status" >&3; then
                    unset _jks_stdout_encoded _jks_stdout_od_status _jks_stdout_drain_status
                    exit 1
                fi
                unset _jks_stdout_encoded _jks_stdout_od_status _jks_stdout_drain_status
            }
        ); then
            _jks_stdout_capture_status=0
        else
            _jks_stdout_capture_status=$?
        fi
        _jks_stdout_parse_status=0
        _jks_stdout_parsed=
        if _jks_stdout_parsed=$(printf '%s' "$_jks_stdout_capture" | LC_ALL=C awk -v capture_status="$_jks_stdout_capture_status" '
            function valid_status(value) {
                if (value !~ /^[0-9]+$/ || length(value) > 3) return 0
                if (length(value) > 1 && substr(value, 1, 1) == "0") return 0
                return value + 0 <= 255
            }
            function valid_count(value) {
                if (value !~ /^[0-9]+$/ || length(value) > 5) return 0
                if (length(value) > 1 && substr(value, 1, 1) == "0") return 0
                return value + 0 <= 65537
            }
            function status_value(line, tag, value) {
                if (index(line, tag "\t") != 1) return ""
                value = substr(line, length(tag) + 2)
                if (!valid_status(value)) return ""
                return value
            }
            function response_space(value) {
                return value == "20" || value == "09" || value == "0a" || value == "0d" || value == "0b" || value == "0c"
            }
            function response_byte(value) {
                if (response_bad) return
                if (response_state == 0) {
                    if (response_space(value)) return
                    if (value == "72") response_state = 1
                    else response_bad = 1
                    return
                }
                if (response_state == 1 && value == "65") response_state = 2
                else if (response_state == 2 && value == "61") response_state = 3
                else if (response_state == 3 && value == "64") response_state = 4
                else if (response_state == 4 && value == "79") {
                    response_state = 5
                    ready_found = 1
                } else if (response_state == 5 && response_space(value)) response_state = 6
                else if (response_state == 6 && response_space(value)) return
                else response_bad = 1
            }
            function parse_hex_line(line, trimmed, token_count, tokens, i) {
                trimmed = line
                sub(/^[[:space:]]+/, "", trimmed)
                sub(/[[:space:]]+$/, "", trimmed)
                if (trimmed == "") return 1
                token_count = split(trimmed, tokens, /[[:space:]]+/)
                for (i = 1; i <= token_count; i++) {
                    if (length(tokens[i]) != 2 || tokens[i] !~ /^[[:xdigit:]][[:xdigit:]]$/) {
                        grammar_bad = 1
                        return 0
                    }
                    byte_count++
                    if (byte_count > 65537) grammar_bad = 1
                    response_byte(tolower(tokens[i]))
                }
                return 1
            }
            function parse_success_record(line, producer_value, od_value, drain_value) {
                if (state == 0) {
                    producer_value = status_value(line, "!P")
                    if (producer_value == "") grammar_bad = 1
                    state = 1
                    return
                }
                if (state == 1) {
                    if (line != "!H") grammar_bad = 1
                    state = 2
                    return
                }
                if (state == 2) {
                    od_value = status_value(line, "!O")
                    if (od_value != "") {
                        od_status = od_value
                        state = 3
                    } else {
                        parse_hex_line(line)
                    }
                    return
                }
                if (state == 3) {
                    drain_value = status_value(line, "!D")
                    if (drain_value == "") grammar_bad = 1
                    else {
                        drain_status = drain_value
                        state = 4
                    }
                    return
                }
                grammar_bad = 1
            }
            {
                line = $0
                records[NR] = line
                if (line == "!P" || index(line, "!P\t") == 1) {
                    record_kind[NR] = "P"
                    producer_records++
                    producer_value = status_value(line, "!P")
                    if (producer_value != "") {
                        producer_valid_seen++
                        producer_valid_status = producer_value
                    }
                } else if (line == "!E" || index(line, "!E\t") == 1) {
                    record_kind[NR] = "E"
                    error_records++
                    error_fields = split(line, error_parts, "\t")
                    if (error_fields != 4 || line != "!E\t" error_parts[2] "\t" error_parts[3] "\t" error_parts[4] ||
                        !valid_status(error_parts[2]) || !valid_status(error_parts[3]) || !valid_count(error_parts[4]) ||
                        (error_parts[2] + 0 == 0 && error_parts[3] + 0 == 0)) {
                        error_bad = 1
                    } else {
                        error_bytes = error_parts[4] + 0
                    }
                } else {
                    record_kind[NR] = "unknown"
                }
            }
            END {
                producer_code = "null"
                output_bytes = 0
                answer = 0
                if (producer_records == 1 && producer_valid_seen == 1) producer_code = producer_valid_status
                if (error_records > 0) {
                    error_frame_bad = error_bad || capture_status == 0 || error_records != 1 || producer_records > 1
                    for (i = 1; i <= NR; i++) {
                        if (record_kind[i] != "P" && record_kind[i] != "E") error_frame_bad = 1
                    }
                    if (!error_frame_bad) output_bytes = error_bytes
                } else {
                    for (i = 1; i <= NR; i++) parse_success_record(records[i])
                    if (state == 4 && !grammar_bad && producer_records == 1 && producer_valid_seen == 1) output_bytes = byte_count
                    if (capture_status == 0 && state == 4 && !grammar_bad && producer_records == 1 && producer_valid_seen == 1 && producer_code == 0 && od_status == 0 && drain_status == 0 && byte_count <= 65536 && ready_found && !response_bad && (response_state == 5 || response_state == 6)) answer = 1
                }
                printf "%s %d %d\n", producer_code, output_bytes, answer
            }
        ' 3>&- 2>/dev/null); then
            _jks_stdout_parse_status=0
        else
            _jks_stdout_parse_status=$?
        fi
        unset _jks_stdout_capture _jks_stdout_capture_status
        if [ "$_jks_stdout_parse_status" -eq 0 ]; then
            _jks_stdout_extra=
            if IFS=' ' read -r _jks_stdout_parsed_exit _jks_stdout_parsed_bytes _jks_stdout_parsed_answer _jks_stdout_extra <<EOF
$_jks_stdout_parsed
EOF
            then
                case "$_jks_stdout_parsed_exit" in
                    null) exit_code= ;;
                    '' | *[!0-9]*) exit_code= ;;
                    *)
                        if [ "$_jks_stdout_parsed_exit" -le 255 ]; then
                            exit_code=$_jks_stdout_parsed_exit
                        fi
                        ;;
                esac
                case "$_jks_stdout_parsed_bytes" in
                    '' | *[!0-9]*) bytes=0 ;;
                    *)
                        if [ "$_jks_stdout_parsed_bytes" -le 65537 ]; then
                            bytes=$_jks_stdout_parsed_bytes
                        fi
                        ;;
                esac
                if [ "$_jks_stdout_parsed_answer" = 1 ] && [ -z "$_jks_stdout_extra" ]; then
                    answered=true
                fi
            fi
        fi
    fi
    unset _jks_stdout_capture _jks_stdout_capture_status _jks_stdout_encoded _jks_stdout_producer_status
    unset _jks_stdout_od_status _jks_stdout_drain_status _jks_stdout_encoded_bytes _jks_stdout_count_status
    unset _jks_stdout_parsed _jks_stdout_parse_status _jks_stdout_parsed_exit _jks_stdout_parsed_bytes
    unset _jks_stdout_parsed_answer _jks_stdout_extra
    evidence=$(agent_tool_evidence) || evidence='{"actual_provider":"","actual_model":"","actual_endpoint":"","sandbox_endpoint":"","tool":{"kind":"","attempted":false,"succeeded":false,"exit_code":null,"workdir":"","observation":[]}}'
    _jks_agent_exec_doc=$(jq -n --arg credential "$launch_kind" --argjson attempted "$attempted" --arg exit_code "$exit_code" \
        --argjson answered "$answered" --argjson bytes "$bytes" --argjson evidence "$evidence" \
        "$JQN"'{attempted: $attempted, credential: $credential, exit_code: ($exit_code | n | if . == null then null else tonumber end),
          answered: $answered, output_bytes: $bytes,
          actual_provider: $evidence.actual_provider, actual_model: $evidence.actual_model,
          actual_endpoint: $evidence.actual_endpoint, sandbox_endpoint: $evidence.sandbox_endpoint, tool: $evidence.tool}') || exit 70
    printf '%s\n' "$_jks_agent_exec_doc" >"$work/agent_exec.json" || exit 70
    agent_exec_seal || exit 70
}

egress() {
    url=$1
    bearer=${2-}
    body=${3-/dev/null}
    if ! have curl; then
        jq -cn --arg url "$url" '{url: $url, curl_found: false, curl_exit: null, http_code: 0, body: null}'
        return 0
    fi
    if [ -n "$bearer" ]; then
        printf 'Authorization: Bearer %s\n' "$bearer" >"$work/header"
        code=$(curl -q -sS --noproxy '*' -o "$body" --max-filesize 65536 -w '%{http_code}' --connect-timeout 5 --max-time 15 -H "@$work/header" "$url" 2>/dev/null </dev/null)
        rc=$?
    else
        code=$(curl -q -sS --noproxy '*' -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 15 "$url" 2>/dev/null </dev/null)
        rc=$?
    fi
    jq -cn --arg url "$url" --argjson rc "$rc" --arg code "${code:-000}" \
        '{url: $url, curl_found: true, curl_exit: $rc, http_code: ($code | tonumber), body: null}'
}

egress_outcome() {
    printf '%s' "$1" | jq -r '
        if .curl_found != true then "curl_missing"
        elif .http_code != 0 then "answered"
        elif .curl_exit == 7 then "refused"
        elif .curl_exit == 6 then "unresolved"
        else "failed" end'
}

egress_fault() {
    case $(egress_outcome "$2") in
        curl_missing) echo "curl is not installed, so the probe cannot test $1" ;;
        answered) echo "$1 answered HTTP $(printf '%s' "$2" | jq -r '.http_code')" ;;
        unresolved) echo "$1 did not resolve (curl exit 6): a resolver fault is not a policy denial" ;;
        *) echo "$1 gave curl exit $(printf '%s' "$2" | jq -r '.curl_exit') and no HTTP response: not a policy denial" ;;
    esac
}

provider_saw_only() {
    head -c 65536 "$2" 2>/dev/null | jq -e --arg p "$1" '
        def shown: if ($p | length) > 12 then $p[0:8] + ([range(($p | length) - 12)] | map("*") | join("")) + $p[-4:] else $p end;
        .error.code == "invalid_api_key"
        and (.error.message | type == "string")
        and (.error.message as $m | [shown, $p] | any(. as $s | $m | startswith("Incorrect API key provided: " + $s + ". ")))' >/dev/null 2>&1
}

denial_check() {
    if [ "$(egress_outcome "$3")" = refused ]; then
        pass "$1" "$2 refused the connection (curl exit 7, no HTTP response)"
    else
        fail "$1" "$(egress_fault "$2" "$3")"
    fi
}

proxy_variables() {
    env | awk -F= '$1 ~ /^[A-Za-z_][A-Za-z0-9_]*_(PROXY|proxy)$/ { print $1 }'
}

token_kinds() {
    jq -r --arg re "$PLACEHOLDER_RE" --arg id_token "$PLACEHOLDER_ID_TOKEN" '
        def kind($v; $jwt):
            if $v == null then "absent"
            elif $v == "" then "empty"
            elif $jwt then (if $v == $id_token then "placeholder" else "other" end)
            elif ($v | type == "string" and test($re + "\\z")) then "placeholder"
            else "other" end;
        def worst:
            if any(. == "other") then "other"
            elif any(. == "placeholder") then "placeholder"
            elif any(. == "empty") then "empty"
            else "absent" end;
        [([kind(.tokens.access_token; false), kind(.OPENAI_API_KEY; false)] | worst),
         kind(.tokens.refresh_token; false),
         kind(.tokens.id_token; true)] | @tsv' "$1"
}

auth_file_fields() {
    printf '%s\n' "$SPEC_JSON" | jq -cn --slurpfile parsed "$1" --slurpfile selected /dev/stdin --arg re "$PLACEHOLDER_RE" --arg id_token "$PLACEHOLDER_ID_TOKEN" '
        def pointer($name): $name | split("/") | map(select(length > 0));
        def kind($value; $jwt):
            if $value == null then "absent"
            elif $value == "" then "empty"
            elif $jwt and $value == $id_token then "placeholder"
            elif ($value | type == "string" and (test($re + "\\z") or . == "placeholder")) then "placeholder"
            else "other" end;
        [$selected[0].behavior.credential.auth_file.fields[] as $field |
            ($parsed[0] | getpath(pointer($field.name))) as $value |
            if ($field.kind | type) == "object" and $field.kind.literal.value != null then
                {name: $field.name, kind: (if $value == $field.kind.literal.value then "literal:" + $value else "other" end)}
            else
                {name: $field.name, kind: kind($value; $field.name == "/tokens/id_token")}
            end]'
}

credential_variables() {
    jq -Rrs --arg source "$1" --arg re "$PLACEHOLDER_RE" '
        def kind($value):
            if $value == "" then "empty"
            elif ($value | test($re + "\\z")) then "placeholder"
            else "other" end;
        split("\u0000")[]
        | select(length > 0)
        | (index("=")) as $separator
        | select($separator != null)
        | .[0:$separator] as $name
        | .[($separator + 1):] as $value
        | select($name | test("^[A-Za-z_][A-Za-z0-9_]*$"))
        | ($name | ascii_upcase) as $upper
        | select($upper != "SSH_AUTH_SOCK" and (
              ($upper | test("(^|_)(KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIALS?|AUTH)(_|$)"))
              or ($upper | test("(TOKEN|SECRET|SECRETS|PASSWORD|PASSWD|CREDENTIALS?)$"))
              or ($upper | test("_PWD$"))))
        | [$name, kind($value), $source] | @tsv'
}

sanitize_launch_environment() {
    launch_names=$(env -0 2>/dev/null | jq -Rrs 'split("\u0000") | map(select(length > 0) | split("=")[0]) | .[]' 2>/dev/null) || return 1
    while IFS= read -r launch_name; do
        [ -n "$launch_name" ] || continue
        case $launch_name in
            *[!A-Za-z0-9_]*) continue ;;
        esac
        case $launch_name in
            PATH | HOME | LANG | LANGUAGE | LC_ALL | LC_CTYPE | TERM | USER | LOGNAME | SHELL | TZ | PWD | OLDPWD | CODEX_HOME | CODEX_AUTH_ACCESS_TOKEN | OPENAI_API_KEY) continue ;;
        esac
        [ "$launch_name" = "$CREDENTIAL_ENV" ] && continue
        unset "$launch_name"
    done <<EOF
$launch_names
EOF
    return 0
}

is_placeholder() {
    jq -Rrse --arg re "$PLACEHOLDER_RE" 'test($re + "\\z")' >/dev/null 2>&1
}

leak_id() {
    printf '%s' "$1" | sha256sum | cut -c1-12 | sed 's/^/leak-/'
}

sanitize_find_error() {
    error_line=$1
    error_path=$(printf '%s\n' "$error_line" | sed -nE "s#^find: ['‘](/[^:]*)['’]: .*#\\1#p")
    if [ -z "$error_path" ]; then
        error_path=$(printf '%s\n' "$error_line" | sed -nE 's#^find: (/[^:]*): .*#\1#p')
    fi
    if [ -n "$error_path" ]; then
        leak_id "$error_path"
    else
        printf 'find error\n'
    fi
}

scan_leaks() {
    cat >"$work/scan-file.sh" <<'EOF'
emit() {
    jq -cn --arg kind "$1" --arg path "$2" --arg why "$3" '{kind: $kind, path: $path, why: $why}' ||
        echo "the scan could not record a $1" >&2
}
listed() {
    { timeout "$SCAN_GREP_SECONDS" grep -azoE -e "$1" "$3" || [ $? -eq 1 ] || printf 'SCAN_ERROR\0'; } |
        jq -Rrs --arg safe "$2" '
            split("\u0000") | map(select(. != ""))
            | if any(.[]; . == "SCAN_ERROR") then "error"
              elif any(.[]; (test($safe) | not)) then "hit"
              else "none" end' 2>/dev/null || printf error
}
jwt_listed() {
    { timeout "$SCAN_GREP_SECONDS" grep -aoE -e "$1" "$3" || [ $? -eq 1 ] || echo SCAN_ERROR; } |
        jq -nrR --arg safe "$2" --arg leak_sk "$LEAK_SK" '
            def b64: gsub("-"; "+") | gsub("_"; "/")
                | (length % 4) as $m
                | if $m == 2 then . + "==" elif $m == 3 then . + "=" elif $m == 1 then error("length") else . end
                | @base64d;
            def unique_top_keys($parsed):
                reduce scan("\"(?:[^\"\\\\]|\\\\.)*\"|\\{|\\}|\\[|\\]|,") as $token
                    ({depth: 0, want_key: false, names: []};
                     if $token == "{" or $token == "[" then
                         .depth += 1 | if .depth == 1 then .want_key = true else . end
                     elif $token == "}" or $token == "]" then
                         .depth -= 1
                     elif $token == "," then
                         if .depth == 1 then .want_key = true else . end
                     elif .depth == 1 and .want_key and ($token | startswith("\"")) then
                         .names += [($token | fromjson)] | .want_key = false
                     else . end)
                | .names as $names
                | (($names | length) == ($names | unique | length))
                  and (($names | sort) == ($parsed | keys | sort));
            def object_part($i):
                split(".")[$i] | b64 | . as $raw
                | ($raw | fromjson) as $parsed
                | if ($parsed | type) == "object" and ($raw | unique_top_keys($parsed))
                  then $parsed else error("unrecognized cookie object") end;
            def audience: if type == "string" then . == "chatgpt.com" elif type == "array" then . == ["chatgpt.com"] else false end;
            def known_cookie:
                (split(".")[2] | startswith("eyJ") | not)
                and (object_part(0) | type == "object" and .alg == "ES256" and .kid == "oailb-v1"
                     and ((keys | sort) == ["alg", "kid"]
                          or ((keys | sort) == ["alg", "kid", "typ"] and .typ == "JWT")))
                and (object_part(1) | type == "object" and (keys | sort) == ["aud", "exp", "host", "iat", "iss"]
                     and .iss == "edge-gateway" and (.aud | audience)
                     and (.host | type == "string") and (.host | test($leak_sk) | not) and (.iat | type == "number") and (.exp | type == "number"));
            def verdict:
                if . == "SCAN_ERROR" then "error"
                elif test($safe) then "none"
                else (try (if known_cookie then "none" else "hit" end) catch "hit")
                end;
            reduce (inputs | verdict) as $v ("none";
                if . == "error" or $v == "error" then "error" elif . == "hit" or $v == "hit" then "hit" else "none" end)'
}
json_refresh() {
    case $(head -c 512 -- "$1" 2>/dev/null | tr -d '[:space:]' | head -c 1) in
        '{' | '[') ;;
        *)
            printf none
            return
            ;;
    esac
    json_out=$(timeout "$SCAN_GREP_SECONDS" jq -r --arg placeholder "$PLACEHOLDER_RE" '
        [.. | objects | to_entries[]
         | select(.key == "refresh_token")
         | .value
         | select(type == "string")
         | select(length > 0)
         | select(test($placeholder + "\\z") | not)]
        | if length > 0 then "hit" else empty end' "$1" 2>/dev/null)
    json_rc=$?
    case $json_rc in
        0)
            if [ -n "$json_out" ]; then
                printf hit
            else
                printf none
            fi
            ;;
        124) printf error ;;
        *) printf none ;;
    esac
}
scan_count=$(cat "$SCAN_COUNT" 2>/dev/null) || scan_count=0
case $scan_count in
    '' | *[!0-9]*) scan_count=0 ;;
esac
scan_now=$(date +%s) || scan_now=0
if [ "$scan_now" -ge $((SCAN_START + SCAN_DEADLINE_SECONDS)) ]; then
    emit exhausted "$SCAN_ROOT" "the scan deadline of $SCAN_DEADLINE_SECONDS seconds expired"
    kill -TERM "$PPID" 2>/dev/null
    exit 0
fi
for file; do
    if [ "$scan_count" -ge "$SCAN_MAX_FILES" ]; then
        emit exhausted "$SCAN_ROOT" "the scan budget of $SCAN_MAX_FILES entries is exhausted"
        kill -TERM "$PPID" 2>/dev/null
        exit 0
    fi
    scan_count=$((scan_count + 1))
    printf '%s\n' "$scan_count" >"$SCAN_COUNT"
    if [ ! -r "$file" ]; then
        emit unscanned "$file" unreadable
        continue
    fi
    if [ -L "$file" ] || [ ! -f "$file" ]; then
        emit unscanned "$file" "not a regular file"
        continue
    fi
    scan_name=${file##*/}
    snapshot=$SCAN_WORK/scan/$scan_name
    rm -f "$snapshot"
    timeout "$SCAN_GREP_SECONDS" sh "$SCAN_WORK/bounded-copy.sh" "$file" "$snapshot" "$SCAN_CAP" "$SCAN_WORK/scan/copy.err" \
        >"$SCAN_WORK/scan/copy.bytes" 2>/dev/null
    copy_rc=$?
    if [ "$copy_rc" -eq 2 ]; then
        rm -f "$snapshot"
        emit unscanned "$file" "over the size cap"
        continue
    fi
    if [ "$copy_rc" -ne 0 ]; then
