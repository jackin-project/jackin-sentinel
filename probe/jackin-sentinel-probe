    else
        fail git_isolated "the git inspection is not isolated from the host git configuration: $(printf '%s' "$excludes_config" | tr '\t' ' ' | tr '\n' ';' | cut -c1-200)"
    fi
    if [ "$work_tree" = false ]; then
