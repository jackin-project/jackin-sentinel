        none | hit) ;;
        *) jwt=error ;;
    esac
    rt=$(listed "$LEAK_RT" "$LEAK_RT_SAFE" "$snapshot")
    if [ "$rt" != hit ]; then
        json=$(json_refresh "$file")
        if [ "$json" = hit ]; then
            rt=hit
        elif [ "$json" = error ]; then
            rt=error
        fi
    fi
    rm -f "$snapshot"
    if [ "$sk" -eq 0 ] || [ "$jwt" = hit ] || [ "$rt" = hit ]; then
        emit leak "$file" "token-shaped string"
    elif [ "$sk" -ge 2 ] || [ "$jwt" = error ] || [ "$rt" = error ]; then
        emit unscanned "$file" "grep failed or timed out"
    fi
done
exit 0
EOF
