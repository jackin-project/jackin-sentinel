step_J13() (
    work_tree=false
    branch=
    head=
    clean=false
    status_known=false
    refs_known=false
    stash=0
    branches='[]'
    git_isolated=false
    excludes_config=
    if in_work_tree; then
        work_tree=true
        branch=$(git_in symbolic-ref --short -q HEAD 2>/dev/null)
        head=$(git_in rev-parse -q --verify HEAD 2>/dev/null)
        excludes_config=$(git_in config --show-scope --show-origin --get-all core.excludesFile 2>/dev/null) || excludes_config=
        excludes_pinned=false
        excludes_leak=false
        while IFS="$(printf '\t')" read -r excludes_scope excludes_origin excludes_value; do
            [ -n "$excludes_scope" ] || continue
            case $excludes_scope in
                global | env) excludes_leak=true ;;
                command)
                    if [ "$excludes_origin" = "command line:" ] && [ "$excludes_value" = "/dev/null" ]; then
                        excludes_pinned=true
                    fi
                    ;;
            esac
        done <<EOF
$excludes_config
EOF
        if [ "$excludes_pinned" = true ] && [ "$excludes_leak" = false ]; then
            git_isolated=true
        fi
        filter_drivers=$(git_filter_drivers)
        set --
        while IFS= read -r driver; do
            [ -n "$driver" ] || continue
            set -- "$@" -c "filter.$driver.clean=" -c "filter.$driver.smudge=" -c "filter.$driver.process=" -c "filter.$driver.required=false"
        done <<EOF
$filter_drivers
EOF
        set -- "$@" -c core.fileMode=true -c core.trustctime=true -c core.checkStat=default status --porcelain --untracked-files=all --ignore-submodules=none
        if porcelain=$(git_in "$@" 2>/dev/null) &&
            git_in ls-files -v -z >"$work/root-index-flags" 2>/dev/null &&
            git_in ls-files -v -z --recurse-submodules >"$work/recursive-index-flags" 2>/dev/null; then
            status_known=true
            clean=true
            [ -z "$porcelain" ] || clean=false
            if [ "$(git_filter_drivers)" != "$filter_drivers" ]; then
                status_known=false
                clean=false
            fi
            if git_index_flags_state "$work/root-index-flags" "$work/root-index-flags.hex"; then
                :
            else
                flags_rc=$?
                if [ "$flags_rc" -eq 1 ]; then
                    clean=false
                else
                    status_known=false
                    clean=false
                fi
            fi
            if git_index_flags_state "$work/recursive-index-flags" "$work/recursive-index-flags.hex"; then
                :
            else
                flags_rc=$?
                if [ "$flags_rc" -eq 1 ]; then
                    clean=false
                else
                    status_known=false
                    clean=false
                fi
            fi
        else
            clean=false
        fi
        if [ "$git_isolated" = false ]; then
            status_known=false
            clean=false
        fi
