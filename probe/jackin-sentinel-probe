        bearer="openshell:resolve:env:$CREDENTIAL_ENV"
    fi
    provider=null
    if [ -n "$bearer" ] && printf '%s' "$bearer" | is_placeholder; then
        : >"$work/provider.body"
        provider=$(egress "$PROVIDER_URL" "$bearer" "$work/provider.body")
        if provider_saw_only "$bearer" "$work/provider.body"; then
            provider=$(printf '%s' "$provider" | jq -c '.body = "invalid_api_key"')
        else
            provider=$(printf '%s' "$provider" | jq -c '.body = "other"')
        fi
    fi
    complete=$(jq -r --arg provider "$EXPECTED_PROVIDER" --arg model "$EXPECTED_MODEL" --arg kind "$TOOL_KIND" --arg workdir "$TOOL_WORKDIR" '
        .answered == true and .actual_provider == $provider and .actual_model == $model and
        .tool.kind == $kind and .tool.attempted == true and .tool.succeeded == true and
        .tool.exit_code == 0 and .tool.workdir == $workdir and (.tool.observation | length > 0)' "$work/agent_exec.json")
    if [ "$(jq -r '.attempted' "$work/agent_exec.json")" = true ]; then
        if [ "$complete" = true ]; then
            pass agent_reaches_api "codex exec answered and completed the declared tool"
        elif [ "$(jq -r '.answered' "$work/agent_exec.json")" != true ]; then
            fail agent_reaches_api "codex exec exit $(jq -r '.exit_code' "$work/agent_exec.json") gave no answer"
        else
            fail agent_reaches_api "agent exec or tool evidence is incomplete (exit $(jq -r '.exit_code' "$work/agent_exec.json"))"
        fi
    else
        skip agent_reaches_api "$(cat "$work/agent_exec.why")"
    fi
    if [ -n "$proxies" ]; then
        fail outside_host_denied "proxy variables are set: $proxies"
        fail metadata_denied "proxy variables are set: $proxies"
    else
        denial_check outside_host_denied example.com "$outside"
        denial_check metadata_denied 169.254.169.254 "$metadata"
    fi
    if [ "$provider" = null ]; then
        skip provider_no_credential "no placeholder to send"
    elif [ "$(egress_outcome "$provider")" = curl_missing ]; then
        fail provider_no_credential "$(egress_fault api.openai.com "$provider")"
    elif [ "$(egress_outcome "$provider")" = refused ]; then
        pass provider_no_credential "api.openai.com refused the connection, so no credential was applied"
    elif [ "$(egress_outcome "$provider")" != answered ]; then
        fail provider_no_credential "api.openai.com gave no HTTP response, so the probe cannot show that no credential was applied"
    else
        code=$(printf '%s' "$provider" | jq -r '.http_code')
        if [ "$code" != "$PROVIDER_STATUS" ]; then
            fail provider_no_credential "curl got HTTP $code, not the $PROVIDER_STATUS that shows the provider saw only the placeholder"
        elif provider_saw_only "$bearer" "$work/provider.body"; then
            pass provider_no_credential "HTTP $code: the provider named only the placeholder, so no credential was applied"
        else
            fail provider_no_credential "HTTP $code without the invalid-key answer for the placeholder: the provider may have seen another credential"
        fi
    fi
    rm -f "$work/provider.body"
    jq -n --argjson outside "$outside" --argjson metadata "$metadata" --argjson provider "$provider" --slurpfile x "$work/agent_exec.json" \
        '{outside_host: $outside, metadata_host: $metadata, provider_host: $provider, agent_exec: $x[0]}' >"$work/facts"
)

step_J10() (
    mkdir -p "$STATE_DIR" 2>/dev/null
    : >"$work/writes.ndjson"
    allowed_failed=
    denied_created=
    attributed=
    for expected in allowed denied; do
        if [ "$expected" = allowed ]; then
            dirs=$J10_ALLOWED
        else
            dirs=$J10_DENIED
        fi
        for dir in $dirs; do
            [ -d "$dir" ] || [ "$expected" = allowed ] || continue
            path="$dir/jackin-sentinel-j10-$$"
            dac=false
            [ -w "$dir" ] && [ -x "$dir" ] && dac=true
            created=false
            if try_create "$path"; then
                created=true
                create_result=0
            else
                create_result=$?
            fi
            if [ "$created" = true ]; then
                rm -f "$path"
            fi
            if [ "$expected" = allowed ] && [ "$created" = false ]; then
                allowed_failed="$allowed_failed $dir"
            fi
            if [ "$expected" = denied ] && [ "$created" = true ]; then
                denied_created="$denied_created $dir"
            fi
            if [ "$expected" = denied ] && [ "$created" = false ] && [ "$dac" = true ] && [ "$create_result" -eq 1 ]; then
                attributed="$attributed $dir"
            fi
            jq -cn --arg path "$path" --arg expected "$expected" --argjson dac "$dac" --argjson created "$created" \
                '{path: $path, expected: $expected, dac_writable: $dac, created: $created}' >>"$work/writes.ndjson"
        done
    done
    if [ -z "$allowed_failed" ]; then
        pass allowed_writes "files can be created under $J10_ALLOWED"
    else
        fail allowed_writes "cannot create a file in:$allowed_failed"
    fi
    if [ -z "$denied_created" ]; then
        pass denied_writes "no file could be created at a denied path"
    else
        fail denied_writes "a file was created in:$denied_created"
    fi
    if [ -n "$attributed" ]; then
        pass denial_by_policy "denied although the mode allows the write:$attributed"
    else
        fail denial_by_policy "no denied path was writable by mode, so the policy is not proven"
    fi
    jq -n --slurpfile writes "$work/writes.ndjson" '{writes: $writes}' >"$work/facts"
)

step_J11() (
    collect_processes
    process_checks
    jq -n --slurpfile p "$work/processes.json" '{processes: $p[0]}' >"$work/facts"
)

step_J12() (
    collect_processes
    if [ "$(jq -r '.self_descends_from_main' "$work/processes.json")" = false ]; then
        pass not_descendant "the probe is not a descendant of the main process"
    else
        fail not_descendant "the probe runs below the main process"
    fi
    self_tty=$(jq -r '.self.tty // ""' "$work/processes.json")
    agent_children=$(jq -r '.agent | length' "$work/processes.json")
    agent_ttys_known=$(jq -r 'all(.agent[]; .tty != null and .tty != "")' "$work/processes.json")
    shared_ttys=$(jq -r --arg tty "$self_tty" '[.agent[] | select(.tty == $tty)] | length' "$work/processes.json")
    if [ -z "$self_tty" ] || [ "$agent_children" -eq 0 ]; then
        skip distinct_tty "the tty of the probe or of Codex is unknown"
    elif [ "$shared_ttys" -gt 0 ]; then
        fail distinct_tty "$shared_ttys Codex child process(es) share the probe tty $self_tty"
    elif [ "$agent_ttys_known" != true ]; then
        skip distinct_tty "the tty of the probe or of Codex is unknown"
    else
        pass distinct_tty "probe $self_tty, every Codex child has a distinct tty"
    fi
    jq -n --slurpfile p "$work/processes.json" '{processes: $p[0]}' >"$work/facts"
)

step_J13() (
    work_tree=false
    branch=
    head=
    clean=false
    status_known=false
    refs_known=false
    stash=0
    branches='[]'
    if in_work_tree; then
        work_tree=true
        branch=$(git_in symbolic-ref --short -q HEAD 2>/dev/null)
        head=$(git_in rev-parse -q --verify HEAD 2>/dev/null)
        if porcelain=$(git_in -c core.fileMode=true -c core.trustctime=true -c core.checkStat=default status --porcelain --untracked-files=all --ignore-submodules=none 2>/dev/null) &&
            git_in ls-files -v -z >"$work/root-index-flags" 2>/dev/null &&
            git_in ls-files -v -z --recurse-submodules >"$work/recursive-index-flags" 2>/dev/null; then
            status_known=true
            clean=true
            [ -z "$porcelain" ] || clean=false
            if git_index_flags_state "$work/root-index-flags" "$work/root-index-flags.hex"; then
                :
            else
                flags_rc=$?
                if [ "$flags_rc" -eq 1 ]; then
                    clean=false
                else
                    status_known=false
                    clean=false
                fi
            fi
            if git_index_flags_state "$work/recursive-index-flags" "$work/recursive-index-flags.hex"; then
                :
            else
                flags_rc=$?
                if [ "$flags_rc" -eq 1 ]; then
                    clean=false
                else
                    status_known=false
                    clean=false
                fi
            fi
        else
            clean=false
        fi
        : >"$work/refs.err"
        if refs=$(git_in for-each-ref --format='%(refname:short) %(objectname)' refs/heads 2>>"$work/refs.err") &&
            git_in for-each-ref refs/stash >/dev/null 2>>"$work/refs.err" &&
            stashes=$(git_in stash list 2>>"$work/refs.err") && [ ! -s "$work/refs.err" ]; then
            refs_known=true
            [ -z "$stashes" ] || stash=$(printf '%s\n' "$stashes" | wc -l | tr -d ' ')
            if [ -n "$refs" ]; then
                branches=$(printf '%s\n' "$refs" | jq -Rn '[inputs | split(" ") | {name: .[0], tip: .[1]}]') || refs_known=false
            fi
        fi
    fi
    if [ "$work_tree" = true ]; then
        pass work_tree "$PROJECT"
    else
        fail work_tree "$PROJECT is not a git work tree"
    fi
    if [ -n "$head" ]; then
        pass head "$head"
    else
        fail head "HEAD is unborn or unreadable"
    fi
    if [ "$work_tree" = false ]; then
        skip work_tree_status "git status not run: $PROJECT is not a git work tree"
    elif [ "$status_known" = true ]; then
        pass work_tree_status "git status ran"
    else
        fail work_tree_status "Git work-tree inspection failed, so the cleanliness of the work tree is unknown"
    fi
    if [ "$work_tree" = false ]; then
        skip refs "git for-each-ref not run: $PROJECT is not a git work tree"
    elif [ "$refs_known" = true ]; then
        pass refs "$(printf '%s' "$branches" | jq 'length') local branches"
    else
        fail refs "git for-each-ref failed or reported a broken ref: $(head -n 3 "$work/refs.err" 2>/dev/null | tr '\n' ';')"
    fi
    jq -n --arg project "$PROJECT" --argjson work_tree "$work_tree" --arg branch "$branch" --arg head "$head" \
        --argjson branches "$branches" --argjson clean "$clean" --argjson stash "$stash" \
        "$JQN"'{project: $project, work_tree: $work_tree, branch: ($branch | n), head: ($head | n), branches: $branches, clean: $clean, stash: $stash}' >"$work/facts"
)

step_J14() (
    boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null) || boot_id=
    marker=$STATE_DIR/marker
    mkdir -p "$STATE_DIR" 2>/dev/null
    raw_id=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    id=
    created=false
    if (
        set -C
        printf '%s\n' "$raw_id" >"$marker"
    ) 2>/dev/null; then
        created=true
    else
        raw_id=
        marker_bytes=$(od -An -N34 -v -tx1 "$marker" 2>/dev/null) || marker_bytes=
        marker_bytes=$(printf '%s' "$marker_bytes" | tr -d '[:space:]')
        if printf '%s' "$marker_bytes" | grep -qE '^((3[0-9]|6[1-6]){32})(0a)?$'; then
            raw_id=$(printf '%s' "$marker_bytes" | awk '
                BEGIN {
                    for (i = 0; i < 10; i++) chars[sprintf("3%d", i)] = i
                    for (i = 1; i <= 6; i++) chars[sprintf("6%d", i)] = substr("abcdef", i, 1)
                }
                { for (i = 1; i <= 64; i += 2) printf "%s", chars[substr($0, i, 2)] }
            ')
        fi
    fi
    setup_runs=$(count_lines "$STATE_DIR/setup.log")
    preflight_runs=$(count_lines "$STATE_DIR/preflight.log")
    if printf '%s' "$raw_id" | grep -qE '^[0-9a-f]{32}$'; then
        id=$raw_id
        pass marker "created=$created id=$id"
    else
        fail marker "the marker file $marker holds no valid id"
    fi
    if [ -n "$boot_id" ]; then
        pass boot_id "$boot_id"
    else
        fail boot_id "/proc/sys/kernel/random/boot_id is unreadable"
    fi
    jq -n --arg boot_id "$boot_id" --arg path "$marker" --arg id "$id" --argjson created "$created" \
        --argjson setup "$setup_runs" --argjson preflight "$preflight_runs" \
        '{boot_id: $boot_id, marker: {path: $path, id: $id, created: $created}, setup_runs: $setup, preflight_runs: $preflight}' >"$work/facts"
)

docker_capture() (
    unset _jks_docker_deadline _jks_docker_stream _jks_docker_producer_status
    unset _jks_docker_od_status _jks_docker_drain_status _jks_docker_encoded
    _jks_docker_deadline=$1
    _jks_docker_stream=$2
    shift 2
    case $_jks_docker_stream in
        merged | stdout) ;;
        *) exit 64 ;;
    esac
    [ "$#" -gt 0 ] || exit 64
    (
        exec 3>&1 || exit 1
        (
            _jks_docker_producer_status=0
            case $_jks_docker_stream in
                merged)
                    if timeout --kill-after=5 "$_jks_docker_deadline" "$@" 3>&- 2>&1 </dev/null; then
                        :
                    else
                        _jks_docker_producer_status=$?
                    fi
                    ;;
                stdout)
                    if timeout --kill-after=5 "$_jks_docker_deadline" "$@" 3>&- 2>/dev/null </dev/null; then
                        :
                    else
                        _jks_docker_producer_status=$?
                    fi
                    ;;
            esac
            printf '!P\t%s\n' "$_jks_docker_producer_status" >&3 || exit 1
        ) | {
            _jks_docker_od_status=0
            _jks_docker_encoded=
            if _jks_docker_encoded=$(LC_ALL=C timeout --kill-after=5 "$_jks_docker_deadline" od -An -N65537 -v -tx1 3>&- 2>/dev/null); then
                :
            else
                _jks_docker_od_status=$?
            fi
            _jks_docker_drain_status=0
            timeout --kill-after=5 30 cat >/dev/null 3>&- 2>/dev/null || _jks_docker_drain_status=$?
            if ! {
                if [ -n "$_jks_docker_encoded" ]; then
                    printf '!H\n%s\n!O\t%s\n!D\t%s\n!Z\n' "$_jks_docker_encoded" "$_jks_docker_od_status" "$_jks_docker_drain_status"
                else
                    printf '!H\n!O\t%s\n!D\t%s\n!Z\n' "$_jks_docker_od_status" "$_jks_docker_drain_status"
                fi
            } >&3; then
                unset _jks_docker_encoded
                unset _jks_docker_od_status _jks_docker_drain_status
                exit 1
            fi
            unset _jks_docker_encoded
            unset _jks_docker_od_status _jks_docker_drain_status
        }
    )
)

docker_capture_result() {
    LC_ALL=C awk -v capture_status="$1" -v consumer="$2" '
        function valid_status(value) {
            if (value !~ /^[0-9]+$/ || length(value) > 3) return 0
            if (length(value) > 1 && substr(value, 1, 1) == "0") return 0
            return value + 0 <= 255
        }
        function hex_value(value, first, second) {
            value = tolower(value)
            first = index("0123456789abcdef", substr(value, 1, 1)) - 1
            second = index("0123456789abcdef", substr(value, 2, 1)) - 1
            return first * 16 + second
        }
        {
            line = $0
            if (index(line, "!P") == 1) {
                producer_records++
                producer_value = ""
                if (index(line, "!P\t") == 1) producer_value = substr(line, 4)
                if (valid_status(producer_value)) {
                    producer_valid_records++
                    producer_code = producer_value
                }
            }
            if (state == 0) {
                if (index(line, "!P\t") == 1 && valid_status(substr(line, 4))) state = 1
                else grammar_bad = 1
            } else if (state == 1) {
                if (line == "!H") state = 2
                else grammar_bad = 1
            } else if (state == 2) {
                if (index(line, "!O\t") == 1) {
                    od_status = substr(line, 4)
                    if (valid_status(od_status)) {
                        od_records++
                        state = 3
                    } else grammar_bad = 1
                } else {
                    trimmed = line
                    sub(/^[[:space:]]+/, "", trimmed)
                    sub(/[[:space:]]+$/, "", trimmed)
                    if (trimmed == "") {
                        grammar_bad = 1
                    } else {
                        token_count = split(trimmed, tokens, /[[:space:]]+/)
                        for (i = 1; i <= token_count; i++) {
                            token = tolower(tokens[i])
                            if (length(token) != 2 || token !~ /^[[:xdigit:]][[:xdigit:]]$/) {
                                grammar_bad = 1
                            } else {
                                byte_count++
                                if (byte_count > 65537) grammar_bad = 1
                                hex_stream = hex_stream token
                                if (token == "00") nul_seen = 1
                                if (!first_line_done) {
                                    if (token == "0a") first_line_done = 1
                                    else info_line = info_line sprintf("%c", hex_value(token))
                                }
                            }
                        }
                    }
                }
            } else if (state == 3) {
                if (index(line, "!D\t") == 1) {
                    drain_status = substr(line, 4)
                    if (valid_status(drain_status)) {
                        drain_records++
                        state = 4
                    } else grammar_bad = 1
                } else grammar_bad = 1
            } else if (state == 4) {
                if (line == "!Z") state = 5
                else grammar_bad = 1
            } else grammar_bad = 1
        }
        END {
            producer = "null"
            complete = 0
            hello = 0
            engine_id = ""
            engine_version = ""
            if (producer_records == 1 && producer_valid_records == 1) producer = producer_code
            if (state == 5 && !grammar_bad && producer_records == 1 && producer_valid_records == 1 && od_records == 1 && drain_records == 1 && capture_status == 0 && od_status == 0 && drain_status == 0 && byte_count <= 65536 && !nul_seen) complete = 1
            if (consumer == "run" && complete) {
                greeting_hex = "48656c6c6f2066726f6d20446f636b657221"
                greeting_length = length(greeting_hex)
                for (hex_offset = 1; hex_offset <= length(hex_stream) - greeting_length + 1; hex_offset += 2) {
                    if (substr(hex_stream, hex_offset, greeting_length) == greeting_hex) {
                        hello = 1
                        break
                    }
                }
            }
            if (consumer == "info" && complete && producer == "0") {
                sub(/^[ \t]+/, "", info_line)
                sub(/[ \t]+$/, "", info_line)
                if (info_line != "") {
                    if (match(info_line, /[ \t]+/)) {
                        engine_id = substr(info_line, 1, RSTART - 1)
                        engine_version = substr(info_line, RSTART + RLENGTH)
                    } else {
                        engine_id = info_line
                    }
                }
            }
            printf "%s %d %d %s %s\n", producer, complete, hello, engine_id, engine_version
        }
    ' 3>&- 2>/dev/null
}

step_J15() (
    if [ "$docker" != on ]; then
        skip docker_capability "the Docker capability is off (--docker on selects this step)"
        return 0
    fi
    docker_path=$(command -v docker 2>/dev/null) || docker_path=
    found=false
    [ -n "$docker_path" ] && found=true
    cert_dir=$JACKIN_DIR/docker
    : >"$work/certs.ndjson"
    cert_problem=
    for name in ca.pem cert.pem key.pem; do
        meta=$(file_meta "$cert_dir/$name") || meta="65534 000"
        read -r _ mode <<EOF
$meta
EOF
        [ -f "$cert_dir/$name" ] || cert_problem="$cert_problem $name"
        if [ "$name" = key.pem ] && [ "$mode" != 600 ]; then
            cert_problem="$cert_problem key.pem-mode-$mode"
        fi
        jq -cn --arg name "$name" --arg mode "$mode" '{name: $name, mode: $mode}' >>"$work/certs.ndjson"
    done
    host=${DOCKER_HOST-}
